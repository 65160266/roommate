<!-- 
    หน้าแรก (Home)
    - แสดงผู้ใช้ทั้งหมดที่มีประกาศ
    - ค้นหาและกรองผู้ใช้
    - ส่งคำขอจับคู่
-->
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/matching-posts.css">
    <title>RoomMate - หน้าแรก</title>
</head>
<body class="home-container">
    <%- include('partials/homeheader') %>

    <!-- ข้อความแจ้งเตือน -->
    <% if (typeof session !== 'undefined' && session.flash) { %>
        <% if (session.flash.success) { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4 mx-4">
                <%= session.flash.success %>
            </div>
        <% } %>
        <% if (session.flash.error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 mx-4">
                <%= session.flash.error %>
            </div>
        <% } %>
    <% } %>

    <!-- Main Content -->
    <div class="container mx-auto px-4 py-6">
        <!-- Header Section -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between mb-8">
            <!-- Left Side - Navigation Tabs -->
            <div class="flex flex-col sm:flex-row gap-4 mb-6 lg:mb-0">
                <button onclick="showTab('find')" id="find-tab" 
                        class="nav-tab active">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                    จับคู่หารูมแมท
                </button>
                <button onclick="showTab('in-progress')" id="in-progress-tab" 
                        class="nav-tab">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    อยู่ระหว่างดำเนินการจับคู่
                </button>
                <button onclick="showTab('matched')" id="matched-tab" 
                        class="nav-tab">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                    </svg>
                    จับคู่สำเร็จ
                </button>
            </div>

            <!-- Right Side - Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-3">
                <a href="/post" class="action-btn secondary">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    ดูประกาศของฉัน
                </a>
                <% if (!userData.Post_id) { %>
                    <a href="/post/create" class="action-btn primary">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        สร้างประกาศใหม่
                    </a>
                <% } else { %>
                    <button disabled class="action-btn disabled" title="คุณมีประกาศอยู่แล้ว 1 ประกาศ">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                        มีประกาศแล้ว
                    </button>
                <% } %>
            </div>
        </div>

        <!-- Find Roommates Tab -->
        <div id="find-content" class="tab-content">
            <!-- Search Section -->
        <div class="mb-8 flex justify-center items-center gap-3">
            <div class="search-input-wrapper">
                <svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <input type="text" id="search-input" placeholder="ค้นหาเพื่อนร่วมห้อง..." class="search-input-simple">
            </div>
            <button id="filter-button" class="filter-button">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.207A1 1 0 013 6.5V4z"></path>
                </svg>
                กรอง
            </button>
        </div>

            <!-- Search Results Info -->
            <div class="search-results-info mb-4" id="search-results-info" style="display: none;">
                <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                    <div class="flex items-center">
                        <svg class="w-5 h-5 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        <span class="text-green-800 font-medium" id="search-results-text">พบผลลัพธ์การค้นหา</span>
                    </div>
                </div>
            </div>

            <!-- Users Grid - Show all users by default -->
            <div class="users-section" id="users-section">
                <div class="users-grid">
                    <% if (accounts && accounts.length > 0) { %>
                        <% accounts.forEach(user => { %>
                            <% if (user.Accounts_id !== userData.Accounts_id) { %>
                                <div class="user-card">
                                    <!-- User Profile Header -->
                                    <div class="user-profile-header">
                                        <div class="user-avatar-wrapper">
                                            <img src="<%= user.image || '/images/default-avatar.png' %>" alt="profile" class="user-avatar">
                                        </div>
                                        <h3 class="user-name">
                                            <%= user.first_name %> <%= user.last_name %>
                                        </h3>
                                        <p class="user-nickname">@<%= user.nickname %></p>
                                        <p class="user-details"><%= user.faculty_name %> · <%= user.majors_name %></p>
                                        <p class="user-gender" style="display: none;"><%= user.gender %></p>
                                        <p class="user-faculty" style="display: none;"><%= user.faculty_name %></p>
                                        
                                        <!-- Post Information -->
                                        <% if (user.post_title && user.post_content) { %>
                                            <div class="post-info">
                                                <!-- Room Details -->
                                                <!-- Debug: room_status = <%= user.room_status %>, people_needed = <%= user.people_needed %> -->
                                                <% if (user.room_status === 'has_room' && user.people_needed) { %>
                                                    <div class="room-details has-room-status">
                                                        <div class="room-status-header has-room-header">
                                                            <div class="room-status-left">
                                                                <svg class="room-status-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                                                </svg>
                                                                <span class="room-status-text">มีห้องแล้ว</span>
                                                            </div>
                                                            <div class="room-status-right">
                                                                <svg class="room-info-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                                                </svg>
                                                                <span>ต้องการ <%= user.people_needed %> คน</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                <% } else if (user.room_status === 'looking_for_room') { %>
                                                    <!-- Debug: looking_for_room status -->
                                                    <div class="room-details looking-for-room-status">
                                                        <div class="room-status-header looking-for-room-header">
                                                            <div class="room-status-left">
                                                                <svg class="room-status-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                                                </svg>
                                                                <span class="room-status-text">กำลังมองหาห้อง</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                <% } else { %>
                                                    <!-- Default case for other room_status values -->
                                                    <div class="room-details looking-for-room-status">
                                                        <div class="room-status-header looking-for-room-header">
                                                            <div class="room-status-left">
                                                                <svg class="room-status-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                                                </svg>
                                                                <span class="room-status-text">กำลังมองหาห้อง</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                <% } %>
                                                
                                                <div class="post-content">
                                                    <p><%= user.post_content.length > 100 ? user.post_content.substring(0, 100) + '...' : user.post_content %></p>
                                                </div>
                                                
                                            </div>
                                        <% } %>
                                    </div>

                                    <!-- User Info -->
                                    <div class="user-info">
                                        <div class="info-item">
                                            <svg class="info-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                            </svg>
                                            <span>อายุ <%= user.age %> ปี</span>
                                        </div>
                                        <div class="info-item">
                                            <svg class="info-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            </svg>
                                            <span><%= user.faculty_name %></span>
                                        </div>
                                        <div class="info-item">
                                            <svg class="info-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                                            </svg>
                                            <span><%= user.majors_name %></span>
                                        </div>
                                    </div>


                                    <!-- Personality Tags -->
                                    <% if (user.Personality && user.Personality.length > 0) { %>
                                        <div class="personality-tags">
                                            <% user.Personality.split(',').slice(0, 3).forEach(tag => { %>
                                                <span class="personality-tag"><%= tag.trim() %></span>
                                            <% }) %>
                                        </div>
                                    <% } %>


                                    <!-- Action Buttons -->
                                    <div class="user-actions">
                                        <button onclick="matchUser('<%= user.Accounts_id %>')" class="action-match">
                                            จับคู่
                                        </button>
                                        <button onclick="passUser('<%= user.Accounts_id %>')" class="action-pass">
                                            ไม่สนใจ
                                        </button>
                                    </div>
                                </div>
                            <% } %>
                        <% }) %>
                    <% } else { %>
                        <div class="empty-state">
                            <svg class="empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                            </svg>
                            <h3 class="empty-title">ไม่พบผู้ใช้</h3>
                            <p class="empty-text">ยังไม่มีผู้ใช้ในระบบ</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- In-Progress Tab -->
        <div id="in-progress-content" class="tab-content hidden">
            <div class="empty-state">
                <svg class="empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <h3 class="empty-title">กำลังดำเนินการ</h3>
                <p class="empty-text">ยังไม่มีรายการที่กำลังดำเนินการ</p>
            </div>
        </div>

        <!-- Matched Tab -->
        <div id="matched-content" class="tab-content hidden">
            <div class="empty-state">
                <svg class="empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                </svg>
                <h3 class="empty-title">จับคู่สำเร็จ</h3>
                <p class="empty-text">ยังไม่มีรายการที่จับคู่สำเร็จ</p>
            </div>
        </div>
    </div>

    <!-- Filter Modal -->
    <div id="filter-modal" class="filter-modal">
        <div class="filter-modal-content">
            <div class="filter-modal-header">
                <h3 class="text-lg font-semibold text-gray-900">กรองข้อมูล</h3>
                <button id="close-filter-modal" class="close-button">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            
            <div class="filter-modal-body">
                <!-- Gender Filter -->
                <div class="filter-section">
                    <label class="filter-label">เพศ</label>
                    <div class="filter-options">
                        <label class="filter-option">
                            <input type="radio" name="gender" value="" checked>
                            <span class="filter-option-text">ทั้งหมด</span>
                        </label>
                        <label class="filter-option">
                            <input type="radio" name="gender" value="ชาย">
                            <span class="filter-option-text">ชาย</span>
                        </label>
                        <label class="filter-option">
                            <input type="radio" name="gender" value="หญิง">
                            <span class="filter-option-text">หญิง</span>
                        </label>
                        <label class="filter-option">
                            <input type="radio" name="gender" value="LGBTQ">
                            <span class="filter-option-text">LGBTQ</span>
                        </label>
                        <label class="filter-option">
                            <input type="radio" name="gender" value="อื่นๆ">
                            <span class="filter-option-text">อื่นๆ</span>
                        </label>
                    </div>
                </div>

                <!-- Faculty Filter -->
                <div class="filter-section">
                    <label class="filter-label">คณะ</label>
                    <div class="filter-options">
                        <label class="filter-option">
                            <input type="radio" name="faculty" value="" checked>
                            <span class="filter-option-text">ทั้งหมด</span>
                        </label>
                        <label class="filter-option">
                            <input type="radio" name="faculty" value="ศึกษาศาสตร์">
                            <span class="filter-option-text">ศึกษาศาสตร์</span>
                        </label>
                        <label class="filter-option">
                            <input type="radio" name="faculty" value="วิทยาศาสตร์">
                            <span class="filter-option-text">วิทยาศาสตร์</span>
                        </label>
                        <label class="filter-option">
                            <input type="radio" name="faculty" value="วิทยาการสารสนเทศ">
                            <span class="filter-option-text">วิทยาการสารสนเทศ</span>
                        </label>
                        <label class="filter-option">
                            <input type="radio" name="faculty" value="วิศวกรรมศาสตร์">
                            <span class="filter-option-text">วิศวกรรมศาสตร์</span>
                        </label>
                        <label class="filter-option">
                            <input type="radio" name="faculty" value="คณะโลจิสติกส์">
                            <span class="filter-option-text">คณะโลจิสติกส์</span>
                        </label>
                        <label class="filter-option">
                            <input type="radio" name="faculty" value="คณะบริหารธุรกิจและการจัดการ">
                            <span class="filter-option-text">คณะบริหารธุรกิจและการจัดการ</span>
                        </label>
                        <label class="filter-option">
                            <input type="radio" name="faculty" value="คณะศิลปกรรมศาสตร์">
                            <span class="filter-option-text">คณะศิลปกรรมศาสตร์</span>
                        </label>
                        <label class="filter-option">
                            <input type="radio" name="faculty" value="คณะมนุษยศาสตร์และสังคมศาสตร์">
                            <span class="filter-option-text">คณะมนุษยศาสตร์และสังคมศาสตร์</span>
                        </label>
                        <label class="filter-option">
                            <input type="radio" name="faculty" value="คณะเภสัชศาสตร์">
                            <span class="filter-option-text">คณะเภสัชศาสตร์</span>
                        </label>
                        <label class="filter-option">
                            <input type="radio" name="faculty" value="คณะพยาบาลศาสตร์">
                            <span class="filter-option-text">คณะพยาบาลศาสตร์</span>
                        </label>
                        <label class="filter-option">
                            <input type="radio" name="faculty" value="คณะแพทยศาสตร์">
                            <span class="filter-option-text">คณะแพทยศาสตร์</span>
                        </label>
                        <label class="filter-option">
                            <input type="radio" name="faculty" value="คณะสหเวชศาสตร์">
                            <span class="filter-option-text">คณะสหเวชศาสตร์</span>
                        </label>
                        <label class="filter-option">
                            <input type="radio" name="faculty" value="คณะสาธารณสุขศาสตร์">
                            <span class="filter-option-text">คณะสาธารณสุขศาสตร์</span>
                        </label>
                        <label class="filter-option">
                            <input type="radio" name="faculty" value="คณะวิทยาศาสตร์การกีฬา">
                            <span class="filter-option-text">คณะวิทยาศาสตร์การกีฬา</span>
                        </label>
                        <label class="filter-option">
                            <input type="radio" name="faculty" value="คณะดนตรีและการแสดง">
                            <span class="filter-option-text">คณะดนตรีและการแสดง</span>
                        </label>
                    </div>
                </div>

                <!-- Personality Filter -->
                <div class="filter-section">
                    <label class="filter-label">ลักษณะนิสัย/ความชอบ</label>
                    <div class="filter-options">
                        <label class="filter-option">
                            <input type="checkbox" name="personality" value="ชอบอ่านหนังสือ">
                            <span class="filter-option-text">ชอบอ่านหนังสือ</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" name="personality" value="ชอบเล่นกีฬา">
                            <span class="filter-option-text">ชอบเล่นกีฬา</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" name="personality" value="ชอบดูหนัง">
                            <span class="filter-option-text">ชอบดูหนัง</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" name="personality" value="ชอบฟังเพลง">
                            <span class="filter-option-text">ชอบฟังเพลง</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" name="personality" value="ชอบเล่นเกม">
                            <span class="filter-option-text">ชอบเล่นเกม</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" name="personality" value="ชอบออกกำลังกาย">
                            <span class="filter-option-text">ชอบออกกำลังกาย</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" name="personality" value="นอนเร็วก่อน4ทุ่ม">
                            <span class="filter-option-text">นอนเร็วก่อน4ทุ่ม</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" name="personality" value="นอนดึกหลังเที่ยงคืน">
                            <span class="filter-option-text">นอนดึกหลังเที่ยงคืน</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" name="personality" value="ชอบความสะอาด">
                            <span class="filter-option-text">ชอบความสะอาด</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" name="personality" value="ชอบพูดคุยกับเพื่อนๆ">
                            <span class="filter-option-text">ชอบพูดคุยกับเพื่อนๆ</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="filter-modal-footer">
                <button id="clear-filters" class="clear-button">ล้างตัวกรอง</button>
                <button id="apply-filters" class="apply-button">ใช้ตัวกรอง</button>
            </div>
        </div>
    </div>

    <script>
        // Tab switching functionality
        function showTab(tabName) {
            if (tabName === 'in-progress') {
                window.location.href = '/match/in-progress';
                return;
            }
            if (tabName === 'matched') {
                window.location.href = '/match/matched';
                return;
            }
            
            // Hide all tab contents
            document.querySelectorAll('.tab-content').forEach(content => {
                content.classList.add('hidden');
            });
            
            // Remove active class from all tabs
            document.querySelectorAll('.nav-tab').forEach(tab => {
                tab.classList.remove('active');
            });
            
            // Show selected tab content
            document.getElementById(tabName + '-content').classList.remove('hidden');
            
            // Add active class to selected tab
            document.getElementById(tabName + '-tab').classList.add('active');
        }

        // Add event listeners as backup
        document.addEventListener('DOMContentLoaded', function() {
            const matchedTab = document.getElementById('matched-tab');
            if (matchedTab) {
                matchedTab.addEventListener('click', function(e) {
                    e.preventDefault();
                    window.location.href = '/match/matched';
                });
            }

            // Filter functionality
            const filterButton = document.getElementById('filter-button');
            const filterModal = document.getElementById('filter-modal');
            const closeFilterModal = document.getElementById('close-filter-modal');
            const clearFilters = document.getElementById('clear-filters');
            const applyFilters = document.getElementById('apply-filters');

            // Open filter modal
            filterButton.addEventListener('click', function() {
                filterModal.style.display = 'flex';
            });

            // Close filter modal
            closeFilterModal.addEventListener('click', function() {
                filterModal.style.display = 'none';
            });

            // Close modal when clicking outside
            filterModal.addEventListener('click', function(e) {
                if (e.target === filterModal) {
                    filterModal.style.display = 'none';
                }
            });

            // Clear filters
            clearFilters.addEventListener('click', function() {
                // Reset all radio buttons to "ทั้งหมด"
                document.querySelectorAll('input[name="gender"]').forEach(radio => {
                    if (radio.value === '') radio.checked = true;
                });
                document.querySelectorAll('input[name="faculty"]').forEach(radio => {
                    if (radio.value === '') radio.checked = true;
                });
                // Uncheck all personality checkboxes
                document.querySelectorAll('input[name="personality"]').forEach(checkbox => {
                    checkbox.checked = false;
                });
                // Apply filters (which will show all users)
                applyFiltersToUsers();
            });

            // Apply filters
            applyFilters.addEventListener('click', function() {
                applyFiltersToUsers();
                filterModal.style.display = 'none';
            });
        });

        // Apply filters to users
        function applyFiltersToUsers() {
            const usersSection = document.getElementById('users-section');
            const userCards = document.querySelectorAll('.user-card');
            let hasResults = false;
            let resultCount = 0;
            
            // Get filter values
            const selectedGender = document.querySelector('input[name="gender"]:checked')?.value || '';
            const selectedFaculty = document.querySelector('input[name="faculty"]:checked')?.value || '';
            const selectedPersonalities = Array.from(document.querySelectorAll('input[name="personality"]:checked')).map(cb => cb.value);
            
            userCards.forEach(card => {
                let showCard = true;
                
                // Gender filter
                if (selectedGender && showCard) {
                    const userGender = card.querySelector('.user-gender')?.textContent?.trim() || '';
                    if (userGender !== selectedGender) {
                        showCard = false;
                    }
                }
                
                // Faculty filter
                if (selectedFaculty && showCard) {
                    const userFaculty = card.querySelector('.user-faculty')?.textContent?.trim() || '';
                    if (!userFaculty.includes(selectedFaculty)) {
                        showCard = false;
                    }
                }
                
                // Personality filter
                if (selectedPersonalities.length > 0 && showCard) {
                    const personalityTags = card.querySelectorAll('.personality-tag');
                    const userPersonalities = Array.from(personalityTags).map(tag => tag.textContent?.trim().toLowerCase());
                    
                    const hasMatchingPersonality = selectedPersonalities.some(selected => 
                        userPersonalities.some(user => user.includes(selected.toLowerCase()))
                    );
                    
                    if (!hasMatchingPersonality) {
                        showCard = false;
                    }
                }
                
                if (showCard) {
                    card.style.display = 'block';
                    hasResults = true;
                    resultCount++;
                } else {
                    card.style.display = 'none';
                }
            });
            
            // Show/hide users section based on results
            usersSection.style.display = hasResults ? 'block' : 'none';
            const searchResultsInfo = document.getElementById('search-results-info');
            if (hasResults) {
                searchResultsInfo.style.display = 'block';
                searchResultsInfo.querySelector('.search-results-count').textContent = resultCount;
                searchResultsInfo.querySelector('.search-results-text').textContent = 'ผลการกรอง';
            } else {
                searchResultsInfo.style.display = 'none';
            }
        }

        // Search functionality
        document.getElementById('search-input').addEventListener('input', function() {
            const usersSection = document.getElementById('users-section');
            const searchQuery = this.value.trim().toLowerCase();
            
            if (searchQuery !== '') {
                // Filter users based on search query
                const userCards = document.querySelectorAll('.user-card');
                let hasResults = false;
                let resultCount = 0;
                
                userCards.forEach(card => {
                    const userName = card.querySelector('.user-name')?.textContent?.toLowerCase() || '';
                    const userNickname = card.querySelector('.user-nickname')?.textContent?.toLowerCase() || '';
                    const userFaculty = card.querySelector('.user-details')?.textContent?.toLowerCase() || '';
                    const postContent = card.querySelector('.post-content p')?.textContent?.toLowerCase() || '';
                    const personalityTags = card.querySelectorAll('.personality-tag');
                    const roomStatus = card.querySelector('.room-status-text')?.textContent?.toLowerCase() || '';
                    const peopleNeeded = card.querySelector('.room-status-right span')?.textContent?.toLowerCase() || '';
                    
                    let personalityText = '';
                    personalityTags.forEach(tag => {
                        personalityText += tag.textContent?.toLowerCase() + ' ';
                    });
                    
                    // Check if any field matches the search query
                    const matches = userName.includes(searchQuery) || 
                                  userNickname.includes(searchQuery) ||
                                  userFaculty.includes(searchQuery) ||
                                  postContent.includes(searchQuery) ||
                                  personalityText.includes(searchQuery) ||
                                  roomStatus.includes(searchQuery) ||
                                  peopleNeeded.includes(searchQuery);
                    
                    if (matches) {
                        card.style.display = 'block';
                        hasResults = true;
                        resultCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });
                
                // Show/hide users section and results info based on results
                if (hasResults) {
                    usersSection.style.display = 'block';
                    const searchResultsInfo = document.getElementById('search-results-info');
                    const searchResultsText = document.getElementById('search-results-text');
                    searchResultsInfo.style.display = 'block';
                    searchResultsText.textContent = `พบ ${resultCount} รายการที่ตรงกับ "${searchQuery}"`;
                } else {
                    usersSection.style.display = 'none';
                    const searchResultsInfo = document.getElementById('search-results-info');
                    searchResultsInfo.style.display = 'none';
                }
            } else {
                // Show all users when no search
                const userCards = document.querySelectorAll('.user-card');
                userCards.forEach(card => {
                    card.style.display = 'block';
                });
                usersSection.style.display = 'block';
                
                // Hide search results info
                const searchResultsInfo = document.getElementById('search-results-info');
                searchResultsInfo.style.display = 'none';
            }
        });

        // Show users section by default when page loads
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('search-input');
            const usersSection = document.getElementById('users-section');
            
            // Always show users section by default
            usersSection.style.display = 'block';
        });

        // Filter functionality
        document.querySelectorAll('input[name="filter"]').forEach(radio => {
            radio.addEventListener('change', function() {
                // Filter logic here
                console.log('Filter changed to:', this.value);
            });
        });

        // Match/Pass functions
        function matchUser(userId) {
            console.log('Matching user:', userId);
            
            const button = event.target;
            const originalText = button.innerHTML;
            button.innerHTML = 'กำลังจับคู่...';
            button.disabled = true;
            
            console.log('Sending match request to:', '/match');
            console.log('Request body:', JSON.stringify({
                target_user_id: userId,
                action: 'match'
            }));
            
            fetch('/match', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    target_user_id: userId,
                    action: 'match'
                })
            })
            .then(response => {
                console.log('Response status:', response.status);
                return response.json();
            })
            .then(data => {
                console.log('Response data:', data);
                if (data.success) {
                    showNotification('จับคู่สำเร็จ!', 'success');
                    // ลบการ์ดออกทันที
                    const userCard = button.closest('.user-card');
                    userCard.style.transition = 'all 0.3s ease';
                    userCard.style.transform = 'translateX(100%)';
                    userCard.style.opacity = '0';
                    setTimeout(() => {
                        userCard.remove();
                        // Redirect ไปหน้า in-progress
                        window.location.href = '/match/in-progress';
                    }, 300);
                } else {
                    showNotification(data.message || 'เกิดข้อผิดพลาด', 'error');
                    button.innerHTML = originalText;
                    button.disabled = false;
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showNotification('เกิดข้อผิดพลาด', 'error');
                button.innerHTML = originalText;
                button.disabled = false;
            });
        }

        function passUser(userId) {
            console.log('Passing user:', userId);
            
            const button = event.target;
            const originalText = button.innerHTML;
            button.innerHTML = 'กำลังผ่าน...';
            button.disabled = true;
            
            fetch('/match', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    target_user_id: userId,
                    action: 'pass'
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showNotification('ผ่านผู้ใช้แล้ว!', 'success');
                    const userCard = button.closest('.user-card');
                    userCard.style.transition = 'all 0.3s ease';
                    userCard.style.transform = 'translateX(100%)';
                    userCard.style.opacity = '0';
                    setTimeout(() => userCard.remove(), 300);
                } else {
                    showNotification(data.message || 'เกิดข้อผิดพลาด', 'error');
                    button.innerHTML = originalText;
                    button.disabled = false;
                }
            })
            .catch(error => {
                console.error('Error:', error);
                const userCard = button.closest('.user-card');
                userCard.style.transition = 'all 0.3s ease';
                userCard.style.transform = 'translateX(100%)';
                userCard.style.opacity = '0';
                setTimeout(() => userCard.remove(), 300);
            });
        }

        function showEmptyState() {
            const usersGrid = document.querySelector('.users-grid');
            usersGrid.innerHTML = `
                <div class="empty-state">
                    <svg class="empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                    <h3 class="empty-title">ไม่พบผู้ใช้เพิ่มเติม</h3>
                    <p class="empty-text">ลองรีเฟรชหน้าหรือกลับมาทีหลัง</p>
                </div>
            `;
        }

        function showNotification(message, type) {
            // Create notification element
            const notification = document.createElement('div');
            notification.className = `fixed top-4 right-4 z-50 p-4 rounded-lg shadow-lg transition-all duration-300 ${
                type === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
            }`;
            notification.textContent = message;
            
            // Add to page
            document.body.appendChild(notification);
            
            // Remove after 3 seconds
            setTimeout(() => {
                notification.style.opacity = '0';
                notification.style.transform = 'translateX(100%)';
                setTimeout(() => {
                    document.body.removeChild(notification);
                }, 300);
            }, 3000);
        }

    </script>
</body>
</html>