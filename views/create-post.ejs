<!-- 
    หน้าสร้างประกาศหาเพื่อนร่วมห้อง
    - กรอกข้อมูลประกาศ (หัวข้อ, รายละเอียด, จำนวนคน)
    - เผยแพร่ประกาศ
-->
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/create-post.css">
    <title>สร้างประกาศ - RoomMate</title>
</head>
<body class="home-container">
    <%- include('partials/homeheader') %>

    <!-- ข้อความแจ้งเตือน -->
    <% if (typeof session !== 'undefined' && session.flash) { %>
        <% if (session.flash.success) { %>
            <div class="flash-message success">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <%= session.flash.success %>
            </div>
        <% } %>
        <% if (session.flash.error) { %>
            <div class="flash-message error">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <%= session.flash.error %>
            </div>
        <% } %>
    <% } %>

    <div class="create-post-container">
        <div class="create-post-card">
            <div class="create-post-header">
                <h1 class="create-post-title">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                    </svg>
                    สร้างประกาศใหม่
                </h1>
                <a href="/home" class="create-post-close" title="ยกเลิกและกลับหน้าแรก">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </a>
            </div>

            <form action="/post/create" method="POST">
                <!-- Room Status Section -->
                <div class="form-section">
                    <h3 class="form-section-title">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
                        </svg>
                        สถานะห้อง
                    </h3>
                    <div class="radio-group">
                        <label class="radio-item">
                            <input type="radio" name="room_status" value="needs_room" checked>
                            <span>กำลังหาห้อง</span>
                        </label>
                        <label class="radio-item">
                            <input type="radio" name="room_status" value="has_room">
                            <span>มีห้องแล้ว (ต้องการคนเพิ่ม)</span>
                        </label>
                    </div>
                </div>

                <!-- Room Details Section (only show if has room) - Horizontal Layout -->
                <div id="room-details-section" class="form-section hidden">
                    <h3 class="form-section-title">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                        </svg>
                        รายละเอียดห้อง
                    </h3>
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label for="people_needed" class="form-label">
                                ต้องการคนเพิ่มกี่คน
                            </label>
                            <input type="number" 
                                   id="people_needed" 
                                   name="people_needed" 
                                   min="1" 
                                   max="10" 
                                   class="form-input"
                                   placeholder="เช่น 2">
                        </div>
                        <div class="form-group">
                            <label for="room_description" class="form-label">
                                อธิบายเกี่ยวกับห้อง
                            </label>
                            <textarea id="room_description" 
                                      name="room_description" 
                                      rows="3" 
                                      class="form-textarea auto-resize"
                                      placeholder="อธิบายเกี่ยวกับห้อง เช่น ตำแหน่ง ราคา สิ่งอำนวยความสะดวก"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Post Content Section -->
                <div class="form-section">
                    <h3 class="form-section-title">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        เนื้อหาประกาศ
                    </h3>
                    <div class="form-group">
                        <label for="content" class="form-label">
                            เขียนเนื้อหาประกาศของคุณ
                        </label>
                        <textarea id="content" 
                                  name="content" 
                                  rows="6" 
                                  class="form-textarea auto-resize"
                                  placeholder="เขียนเนื้อหาประกาศของคุณที่นี่... เช่น กำลังหาห้องแชร์ หรือมีห้องว่างให้เช่า"
                                  required></textarea>
                        <p class="text-sm text-gray-500 mt-2">
                            เขียนรายละเอียดเกี่ยวกับการหาห้องหรือการแชร์ห้องของคุณ
                        </p>
                    </div>
                </div>

                <!-- Status Info Section -->
                <div class="status-info-section">
                    <div class="status-info-content">
                        <svg class="status-info-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <div class="status-info-text">
                            <h3 class="status-info-title">ข้อมูลสถานะของคุณ</h3>
                            <p class="status-info-description">
                                สถานะ: <span class="font-medium"><%= account.status || 'ยังไม่มีห้อง' %></span>
                            </p>
                            <p class="status-info-hint">
                                ระบบจะแสดงประกาศของคุณให้ผู้ใช้คนอื่นเห็นเพื่อหาห้องแชร์
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="form-actions">
                    <a href="/home" class="btn-cancel">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                        ยกเลิก
                    </a>
                    <button type="submit" class="btn-save">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                        </svg>
                        สร้างประกาศ
                    </button>
                </div>
            </form>

            <!-- Tips Section -->
            <div class="tips-section">
                <h3 class="tips-title">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                    </svg>
                    คำแนะนำ
                </h3>
                <ul class="tips-list">
                    <li class="tips-item">เขียนรายละเอียดเกี่ยวกับห้องที่คุณต้องการหรือมีให้เช่า</li>
                    <li class="tips-item">ระบุราคาและสถานที่ถ้าเป็นไปได้</li>
                    <li class="tips-item">ระบุลักษณะนิสัยหรือไลฟ์สไตล์ที่คุณต้องการ</li>
                    <li class="tips-item">ใส่ข้อมูลติดต่อที่สามารถติดต่อได้</li>
                </ul>
            </div>
        </div>
    </div>

    <script>
        // Auto-resize textarea
        const textarea = document.getElementById('content');
        textarea.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 200) + 'px';
        });

        // Room status change handler
        const roomStatusRadios = document.querySelectorAll('input[name="room_status"]');
        const roomDetailsSection = document.getElementById('room-details-section');

        roomStatusRadios.forEach(radio => {
            radio.addEventListener('change', function() {
                if (this.value === 'has_room') {
                    roomDetailsSection.classList.remove('hidden');
                } else {
                    roomDetailsSection.classList.add('hidden');
                }
            });
        });

        // Form validation
        const form = document.querySelector('form');
        form.addEventListener('submit', function(e) {
            const content = document.getElementById('content').value.trim();
            if (content.length < 10) {
                e.preventDefault();
                alert('กรุณาเขียนเนื้อหาประกาศอย่างน้อย 10 ตัวอักษร');
                return false;
            }

            // Validate room status fields
            const selectedRoomStatus = document.querySelector('input[name="room_status"]:checked').value;
            if (selectedRoomStatus === 'has_room') {
                const peopleNeeded = document.getElementById('people_needed').value;
                if (!peopleNeeded || peopleNeeded < 1) {
                    e.preventDefault();
                    alert('กรุณาระบุจำนวนคนที่ต้องการเพิ่ม');
                    return false;
                }
            }
        });
    </script>
</body>
</html>
