<!-- 
    หน้ารายละเอียดกลุ่ม (Admin)
    - แสดงข้อมูลกลุ่มและสมาชิก
    - แก้ไขชื่อกลุ่ม
    - เตะสมาชิกออกจากกลุ่ม
    - ลบกลุ่ม
-->
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Admin Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .admin-sidebar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
    </style>
</head>
<body class="bg-gray-100">
    <div class="flex h-screen">
        <!-- Sidebar -->
        <div class="admin-sidebar w-64 text-white">
            <div class="p-6">
                <h2 class="text-2xl font-bold mb-8">
                    <i class="fas fa-shield-alt mr-2"></i>
                    Admin Panel
                </h2>
                <nav class="space-y-2">
                    <a href="/admin" class="flex items-center px-4 py-3 rounded-lg hover:bg-white hover:bg-opacity-20 text-white">
                        <i class="fas fa-tachometer-alt mr-3"></i>
                        Dashboard
                    </a>
                    <a href="/admin/users" class="flex items-center px-4 py-3 rounded-lg hover:bg-white hover:bg-opacity-20 text-white">
                        <i class="fas fa-users mr-3"></i>
                        User Management
                    </a>
                    <a href="/admin/groups" class="flex items-center px-4 py-3 rounded-lg bg-white bg-opacity-20 text-white">
                        <i class="fas fa-comments mr-3"></i>
                        Group Management
                    </a>
                </nav>
            </div>
        </div>

        <!-- Main Content -->
        <div class="flex-1 overflow-y-auto">
            <!-- Header -->
            <div class="bg-white shadow-sm border-b">
                <div class="px-6 py-4 flex justify-between items-center">
                    <h1 class="text-2xl font-bold text-gray-800">
                        <i class="fas fa-info-circle mr-2 text-purple-600"></i>
                        Group Details
                    </h1>
                    <div class="flex items-center space-x-4">
                        <a href="/admin/groups" class="text-gray-600 hover:text-gray-800">
                            <i class="fas fa-arrow-left mr-1"></i>
                            Back to Groups
                        </a>
                        <span class="text-gray-400">|</span>
                        <span class="text-gray-600">
                            <i class="fas fa-user-shield mr-1"></i>
                            <%= session.user.email %>
                        </span>
                        <a href="/logout" class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg transition-colors">
                            <i class="fas fa-sign-out-alt mr-1"></i>
                            Logout
                        </a>
                    </div>
                </div>
            </div>

            <!-- Flash Messages -->
            <% if (typeof flashMessages !== 'undefined' && flashMessages.error && flashMessages.error.length > 0) { %>
                <div class="flash-message bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mx-6 mt-4 relative">
                    <button onclick="this.parentElement.style.display='none'" class="absolute top-2 right-2 text-red-700 hover:text-red-900">
                        <i class="fas fa-times"></i>
                    </button>
                    <%= flashMessages.error %>
                </div>
            <% } %>
            <% if (typeof flashMessages !== 'undefined' && flashMessages.success && flashMessages.success.length > 0) { %>
                <div class="flash-message bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mx-6 mt-4 relative">
                    <button onclick="this.parentElement.style.display='none'" class="absolute top-2 right-2 text-green-700 hover:text-green-900">
                        <i class="fas fa-times"></i>
                    </button>
                    <%= flashMessages.success %>
                </div>
            <% } %>

            <!-- Content -->
            <div class="p-6">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Group Information -->
                    <div class="lg:col-span-1">
                        <div class="bg-white rounded-xl shadow-sm p-6">
                            <div class="text-center">
                                <div class="w-16 h-16 bg-blue-500 rounded-full flex items-center justify-center mx-auto mb-4">
                                    <i class="fas fa-comments text-white text-2xl"></i>
                                </div>
                                <div class="flex items-center justify-between mb-2">
                                    <h2 class="text-xl font-bold text-gray-800">
                                        <%= group.group_name %>
                                    </h2>
                                    <button onclick="openEditModal()" 
                                            class="inline-flex items-center px-3 py-1 bg-blue-100 text-blue-700 rounded-lg hover:bg-blue-200 transition-colors"
                                            title="แก้ไขชื่อกลุ่ม">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                </div>
                                <p class="text-gray-600 mb-4">
                                    <%= group.description || 'No description' %>
                                </p>
                                
                                <!-- Group Actions -->
                                <div class="space-y-2">
                                    <a href="/group-chat/<%= group.group_id %>" 
                                       class="w-full bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 block text-center">
                                        <i class="fas fa-comments mr-2"></i>
                                        เข้าแชท
                                    </a>
                                    <button onclick="deleteGroupFromDetail(<%= group.group_id %>)" 
                                            class="w-full bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700">
                                        <i class="fas fa-trash mr-2"></i>
                                        ลบกลุ่ม
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Group Members -->
                    <div class="lg:col-span-2">
                        <div class="bg-white rounded-xl shadow-sm p-6">
                            <h3 class="text-lg font-semibold text-gray-800 mb-4">
                                <i class="fas fa-users mr-2 text-blue-500"></i>
                                Group Members (<%= members.length %>)
                            </h3>
                            
                            <% if (members && members.length > 0) { %>
                                <div class="space-y-3">
                                    <% members.forEach(member => { %>
                                        <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                                            <div class="flex items-center space-x-3">
                                                <img src="<%= member.image || '/images/default-avatar.png' %>" 
                                                     alt="<%= member.first_name %>" 
                                                     class="w-10 h-10 rounded-full object-cover">
                                                <div>
                                                    <p class="font-medium text-gray-800">
                                                        <%= member.first_name %> <%= member.last_name %>
                                                    </p>
                                                    <p class="text-sm text-gray-500">
                                                        <%= member.email %>
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="flex items-center space-x-2">
                                                <% if (member.is_admin) { %>
                                                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">
                                                        Admin
                                                    </span>
                                                <% } else { %>
                                                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">
                                                        Member
                                                    </span>
                                                <% } %>
                                                <button onclick="kickMember(<%= group.group_id %>, <%= member.Accounts_id %>)" 
                                                        class="inline-flex items-center px-3 py-2 bg-red-100 text-red-700 rounded-lg hover:bg-red-200 transition-colors"
                                                        title="เตะออกจากกลุ่ม">
                                                    <i class="fas fa-user-times"></i>
                                                </button>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <p class="text-gray-500 text-center py-4">No members found</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Group Name Modal -->
    <div id="editModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
        <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-md">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-xl font-bold text-gray-800">
                    <i class="fas fa-edit mr-2 text-blue-600"></i>
                    แก้ไขชื่อกลุ่ม
                </h3>
                <button onclick="closeEditModal()" class="text-gray-500 hover:text-gray-700">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>
            
            <form method="POST" action="/admin/groups/<%= group.group_id %>/update-name">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-2">ชื่อกลุ่มใหม่</label>
                    <input type="text" 
                           name="group_name" 
                           value="<%= group.group_name %>"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                           required>
                </div>
                
                <div class="flex space-x-3">
                    <button type="button" 
                            onclick="closeEditModal()"
                            class="flex-1 px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
                        ยกเลิก
                    </button>
                    <button type="submit" 
                            class="flex-1 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                        <i class="fas fa-save mr-2"></i>
                        บันทึก
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openEditModal() {
            document.getElementById('editModal').classList.remove('hidden');
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
        }

        // Close modal when clicking outside
        document.getElementById('editModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeEditModal();
            }
        });

        function deleteGroupFromDetail(groupId) {
            if (confirm('คุณแน่ใจหรือไม่ที่จะลบกลุ่มนี้? การดำเนินการนี้ไม่สามารถย้อนกลับได้')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/admin/groups/${groupId}/delete`;
                
                document.body.appendChild(form);
                form.submit();
            }
        }

        function kickMember(groupId, userId) {
            console.log('Kick member - groupId:', groupId, 'userId:', userId);
            
            if (!userId || userId === 'undefined') {
                alert('ไม่สามารถเตะสมาชิกได้: ไม่พบ user ID');
                return;
            }
            
            if (confirm('คุณแน่ใจหรือไม่ที่จะเตะสมาชิกคนนี้ออกจากกลุ่ม?')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/admin/groups/${groupId}/kick/${userId}`;
                
                console.log('Submitting form to:', form.action);
                document.body.appendChild(form);
                form.submit();
            }
        }

        function removeUser(groupId, userId) {
            if (confirm('Remove this user from the group?')) {
                fetch(`/admin/groups/${groupId}/remove-user/${userId}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => {
                    if (response.ok) {
                        location.reload();
                    } else {
                        alert('เกิดข้อผิดพลาดในการลบสมาชิก');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('เกิดข้อผิดพลาดในการลบสมาชิก');
                });
            }
        }

        // Auto-hide flash messages after 5 seconds
        document.addEventListener('DOMContentLoaded', function() {
            const flashMessages = document.querySelectorAll('.flash-message');
            flashMessages.forEach(function(message) {
                setTimeout(function() {
                    message.style.transition = 'opacity 0.5s';
                    message.style.opacity = '0';
                    setTimeout(function() {
                        message.style.display = 'none';
                    }, 500);
                }, 5000);
            });
        });
    </script>
</body>
</html>



