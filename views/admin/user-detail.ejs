<!-- 
    หน้ารายละเอียดผู้ใช้ (Admin)
    - แสดงข้อมูลผู้ใช้แบบละเอียด
    - แก้ไข Role
    - ปุ่มแก้ไขและลบผู้ใช้
-->
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Admin Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .admin-sidebar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
    </style>
</head>
<body class="bg-gray-100">
    <div class="flex h-screen">
        <!-- Sidebar -->
        <div class="admin-sidebar w-64 text-white">
            <div class="p-6">
                <h2 class="text-2xl font-bold mb-8">
                    <i class="fas fa-shield-alt mr-2"></i>
                    Admin Panel
                </h2>
                <nav class="space-y-2">
                    <a href="/admin" class="flex items-center px-4 py-3 rounded-lg hover:bg-white hover:bg-opacity-20 text-white">
                        <i class="fas fa-tachometer-alt mr-3"></i>
                        Dashboard
                    </a>
                    <a href="/admin/users" class="flex items-center px-4 py-3 rounded-lg bg-white bg-opacity-20 text-white">
                        <i class="fas fa-users mr-3"></i>
                        User Management
                    </a>
                    <a href="/admin/groups" class="flex items-center px-4 py-3 rounded-lg hover:bg-white hover:bg-opacity-20 text-white">
                        <i class="fas fa-comments mr-3"></i>
                        Group Management
                    </a>
                </nav>
            </div>
        </div>

        <!-- Main Content -->
        <div class="flex-1 overflow-y-auto">
            <!-- Header -->
            <div class="bg-white shadow-sm border-b">
                <div class="px-6 py-4 flex justify-between items-center">
                    <h1 class="text-2xl font-bold text-gray-800">
                        <i class="fas fa-user-edit mr-2 text-blue-600"></i>
                        User Details
                    </h1>
                    <div class="flex items-center space-x-4">
                        <a href="/admin/users" class="text-gray-600 hover:text-gray-800">
                            <i class="fas fa-arrow-left mr-1"></i>
                            Back to Users
                        </a>
                        <span class="text-gray-400">|</span>
                        <a href="/admin" class="text-gray-600 hover:text-gray-800">
                            <i class="fas fa-tachometer-alt mr-1"></i>
                            Dashboard
                        </a>
                        <span class="text-gray-400">|</span>
                        <a href="/logout" class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg transition-colors">
                            <i class="fas fa-sign-out-alt mr-1"></i>
                            Logout
                        </a>
                    </div>
                </div>
            </div>

            <!-- Flash Messages -->
            <% if (typeof flashMessages !== 'undefined' && flashMessages.error && flashMessages.error.length > 0) { %>
                <div class="flash-message bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mx-6 mt-4 relative">
                    <button onclick="this.parentElement.style.display='none'" class="absolute top-2 right-2 text-red-700 hover:text-red-900">
                        <i class="fas fa-times"></i>
                    </button>
                    <%= flashMessages.error %>
                </div>
            <% } %>
            <% if (typeof flashMessages !== 'undefined' && flashMessages.success && flashMessages.success.length > 0) { %>
                <div class="flash-message bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mx-6 mt-4 relative">
                    <button onclick="this.parentElement.style.display='none'" class="absolute top-2 right-2 text-green-700 hover:text-green-900">
                        <i class="fas fa-times"></i>
                    </button>
                    <%= flashMessages.success %>
                </div>
            <% } %>

            <!-- Content -->
            <div class="p-6">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- User Profile -->
                    <div class="lg:col-span-1">
                        <div class="bg-white rounded-xl shadow-sm p-6">
                            <div class="text-center">
                                <img src="<%= user.image || '/images/default-avatar.png' %>" 
                                     alt="<%= user.first_name %>" 
                                     class="w-24 h-24 rounded-full object-cover mx-auto mb-4">
                                <h2 class="text-xl font-bold text-gray-800">
                                    <%= user.first_name %> <%= user.last_name %>
                                </h2>
                                <p class="text-gray-600">@<%= user.nickname %></p>
                                <p class="text-sm text-gray-500"><%= user.email %></p>
                                
                                <!-- Edit Button -->
                                <div class="mt-4">
                                    <a href="/admin/users/<%= user.Accounts_id %>/edit" 
                                       class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
                                        <i class="fas fa-edit mr-2"></i>
                                        แก้ไขข้อมูล
                                    </a>
                                </div>
                                
                                <!-- Role Assignment -->
                                <div class="mt-4">
                                    <!-- Current Role Display -->
                                    <div class="mb-3 p-3 bg-gray-50 rounded-lg">
                                        <p class="text-xs text-gray-500 mb-1">Role ปัจจุบัน:</p>
                                        <p class="font-medium">
                                            <% if (user.is_admin == 1 || user.role_id == 1) { %>
                                                <span class="px-3 py-1 bg-red-100 text-red-800 rounded-full text-sm">
                                                    <i class="fas fa-shield-alt mr-1"></i>Admin
                                                </span>
                                            <% } else { %>
                                                <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm">
                                                    <i class="fas fa-user mr-1"></i>User
                                                </span>
                                            <% } %>
                                        </p>
                                    </div>
                                    
                                    <!-- Change Role Form -->
                                    <form method="POST" action="/admin/users/<%= user.Accounts_id %>/assign-role">
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            <i class="fas fa-user-tag mr-1"></i>
                                            เปลี่ยน Role
                                        </label>
                                        <select name="role_id" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 mb-2">
                                            <option value="2" <%= user.role_id == 2 || !user.role_id ? 'selected' : '' %>>User (ผู้ใช้ทั่วไป)</option>
                                            <option value="1" <%= user.role_id == 1 ? 'selected' : '' %>>Admin (ผู้ดูแลระบบ)</option>
                                        </select>
                                        <button type="submit" class="w-full bg-gradient-to-r from-blue-600 to-purple-600 text-white px-4 py-2 rounded-lg hover:from-blue-700 hover:to-purple-700 transition-all">
                                            <i class="fas fa-save mr-2"></i>
                                            บันทึกการเปลี่ยนแปลง
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- User Information -->
                    <div class="lg:col-span-2">
                        <!-- Basic Information -->
                        <div class="bg-white rounded-xl shadow-sm p-6 mb-6">
                            <h3 class="text-lg font-semibold text-gray-800 mb-4">
                                <i class="fas fa-user mr-2 text-blue-500"></i>
                                Basic Information
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">First Name</label>
                                    <p class="text-gray-800 font-medium"><%= user.first_name || '-' %></p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">Last Name</label>
                                    <p class="text-gray-800 font-medium"><%= user.last_name || '-' %></p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">Nickname</label>
                                    <p class="text-gray-800 font-medium"><%= user.nickname || '-' %></p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">Student ID</label>
                                    <p class="text-gray-800 font-medium"><%= user.student_id || '-' %></p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">Age</label>
                                    <p class="text-gray-800 font-medium"><%= user.age || '-' %> ปี</p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">Phone</label>
                                    <p class="text-gray-800 font-medium"><%= user.phone || '-' %></p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">Gender</label>
                                    <p class="text-gray-800 font-medium"><%= user.gender || '-' %></p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">ชั้นปี</label>
                                    <p class="text-gray-800 font-medium"><%= user.year || '-' %></p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">Faculty</label>
                                    <p class="text-gray-800 font-medium"><%= user.faculty_name || '-' %></p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">Major</label>
                                    <p class="text-gray-800 font-medium"><%= user.majors_name || '-' %></p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">Status</label>
                                    <p class="text-gray-800 font-medium">
                                        <span class="px-2 py-1 rounded-full text-xs <%= user.status === 'มีห้องแล้ว' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                                            <%= user.status || 'กำลังมองหาห้อง' %>
                                        </span>
                                    </p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">Registered</label>
                                    <p class="text-gray-800 font-medium"><%= new Date(user.regis_date).toLocaleDateString('th-TH') %></p>
                                </div>
                            </div>
                        </div>

                        <!-- Personality Traits -->
                        <div class="bg-white rounded-xl shadow-sm p-6 mb-6">
                            <h3 class="text-lg font-semibold text-gray-800 mb-4">
                                <i class="fas fa-heart mr-2 text-pink-500"></i>
                                Personality Traits
                            </h3>
                            <% if (personalities && personalities.length > 0) { %>
                                <div class="flex flex-wrap gap-2">
                                    <% personalities.forEach(personality => { %>
                                        <span class="inline-flex px-3 py-1 text-sm font-medium rounded-full bg-pink-100 text-pink-800">
                                            <%= personality.description %>
                                        </span>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <p class="text-gray-500">No personality traits set</p>
                            <% } %>
                        </div>

                        <!-- User Posts -->
                        <div class="bg-white rounded-xl shadow-sm p-6">
                            <h3 class="text-lg font-semibold text-gray-800 mb-4">
                                <i class="fas fa-file-alt mr-2 text-green-500"></i>
                                User Posts
                            </h3>
                            <% if (posts && posts.length > 0) { %>
                                <div class="space-y-4">
                                    <% posts.forEach(post => { %>
                                        <div class="border border-gray-200 rounded-lg p-4 hover:border-blue-300 transition-colors">
                                            <div class="flex justify-between items-start mb-2">
                                                <h4 class="font-medium text-gray-800"><%= post.title || 'โพสต์หาห้อง' %></h4>
                                                <span class="px-2 py-1 text-xs rounded-full <%= post.room_status === 'มีห้องแล้ว' ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800' %>">
                                                    <%= post.room_status || '-' %>
                                                </span>
                                            </div>
                                            <p class="text-gray-600 text-sm mb-2">
                                                <%= (post.content || post.room_description || '').length > 100 ? (post.content || post.room_description || '').substring(0, 100) + '...' : (post.content || post.room_description || '-') %>
                                            </p>
                                            <div class="flex justify-between items-center text-xs text-gray-500">
                                                <span>
                                                    <i class="fas fa-users mr-1"></i>
                                                    ต้องการ <%= post.people_needed || 0 %> คน
                                                </span>
                                                <span>
                                                    <i class="fas fa-calendar mr-1"></i>
                                                    <%= new Date(post.created_at).toLocaleDateString('th-TH') %>
                                                </span>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <p class="text-gray-500 text-center py-4">
                                    <i class="fas fa-inbox text-3xl mb-2 block"></i>
                                    ไม่มีโพสต์
                                </p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Auto-hide flash messages after 5 seconds
        document.addEventListener('DOMContentLoaded', function() {
            const flashMessages = document.querySelectorAll('.flash-message');
            flashMessages.forEach(function(message) {
                setTimeout(function() {
                    message.style.transition = 'opacity 0.5s';
                    message.style.opacity = '0';
                    setTimeout(function() {
                        message.style.display = 'none';
                    }, 500);
                }, 5000);
            });
        });
    </script>
</body>
</html>


