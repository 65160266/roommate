<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Admin Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .admin-sidebar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
    </style>
</head>
<body class="bg-gray-100">
    <div class="flex h-screen">
        <!-- Sidebar -->
        <div class="admin-sidebar w-64 text-white">
            <div class="p-6">
                <h2 class="text-2xl font-bold mb-8">
                    <i class="fas fa-shield-alt mr-2"></i>
                    Admin Panel
                </h2>
                <nav class="space-y-2">
                    <a href="/admin" class="flex items-center px-4 py-3 rounded-lg hover:bg-white hover:bg-opacity-20 text-white">
                        <i class="fas fa-tachometer-alt mr-3"></i>
                        Dashboard
                    </a>
                    <a href="/admin/users" class="flex items-center px-4 py-3 rounded-lg bg-white bg-opacity-20 text-white">
                        <i class="fas fa-users mr-3"></i>
                        User Management
                    </a>
                    <a href="/admin/groups" class="flex items-center px-4 py-3 rounded-lg hover:bg-white hover:bg-opacity-20 text-white">
                        <i class="fas fa-comments mr-3"></i>
                        Group Management
                    </a>
                </nav>
            </div>
        </div>

        <!-- Main Content -->
        <div class="flex-1 overflow-y-auto">
            <!-- Header -->
            <div class="bg-white shadow-sm border-b">
                <div class="px-6 py-4 flex justify-between items-center">
                    <h1 class="text-2xl font-bold text-gray-800">
                        <i class="fas fa-user-edit mr-2 text-blue-600"></i>
                        แก้ไขข้อมูลผู้ใช้
                    </h1>
                    <div class="flex items-center space-x-4">
                        <a href="/admin/users/<%= user.Accounts_id %>" class="text-gray-600 hover:text-gray-800">
                            <i class="fas fa-arrow-left mr-1"></i>
                            กลับ
                        </a>
                        <span class="text-gray-400">|</span>
                        <a href="/logout" class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg transition-colors">
                            <i class="fas fa-sign-out-alt mr-1"></i>
                            Logout
                        </a>
                    </div>
                </div>
            </div>

            <!-- Flash Messages -->
            <% if (typeof flashMessages !== 'undefined' && flashMessages.error && flashMessages.error.length > 0) { %>
                <div class="flash-message bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mx-6 mt-4 relative">
                    <button onclick="this.parentElement.style.display='none'" class="absolute top-2 right-2 text-red-700 hover:text-red-900">
                        <i class="fas fa-times"></i>
                    </button>
                    <%= flashMessages.error %>
                </div>
            <% } %>
            <% if (typeof flashMessages !== 'undefined' && flashMessages.success && flashMessages.success.length > 0) { %>
                <div class="flash-message bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mx-6 mt-4 relative">
                    <button onclick="this.parentElement.style.display='none'" class="absolute top-2 right-2 text-green-700 hover:text-green-900">
                        <i class="fas fa-times"></i>
                    </button>
                    <%= flashMessages.success %>
                </div>
            <% } %>

            <!-- Edit Form -->
            <div class="p-6">
                <div class="bg-white rounded-xl shadow-sm p-6">
                    <form action="/admin/users/<%= user.Accounts_id %>/update" method="POST">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <!-- Personal Information -->
                            <div class="space-y-4">
                                <h3 class="text-lg font-semibold text-gray-800 border-b pb-2">ข้อมูลส่วนตัว</h3>
                                
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">ชื่อ</label>
                                    <input type="text" name="first_name" value="<%= user.first_name %>" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">นามสกุล</label>
                                    <input type="text" name="last_name" value="<%= user.last_name %>" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">ชื่อเล่น</label>
                                    <input type="text" name="nickname" value="<%= user.nickname %>" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">รหัสนักศึกษา</label>
                                    <input type="text" name="student_id" value="<%= user.student_id %>" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">อายุ</label>
                                    <input type="number" name="age" value="<%= user.age %>" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                </div>
                            </div>

                            <!-- Contact & Status -->
                            <div class="space-y-4">
                                <h3 class="text-lg font-semibold text-gray-800 border-b pb-2">ข้อมูลติดต่อ</h3>
                                
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">เบอร์โทร</label>
                                    <input type="tel" name="phone" value="<%= user.phone %>" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">เพศ</label>
                                    <select name="gender" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                        <option value="ชาย" <%= user.gender === 'ชาย' ? 'selected' : '' %>>ชาย</option>
                                        <option value="หญิง" <%= user.gender === 'หญิง' ? 'selected' : '' %>>หญิง</option>
                                        <option value="LGBTQ" <%= user.gender === 'LGBTQ' ? 'selected' : '' %>>LGBTQ</option>
                                    </select>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">ปีการศึกษา</label>
                                    <input type="text" name="year" value="<%= user.year %>" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">สถานะ</label>
                                    <select name="status" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                        <option value="มีห้องแล้ว" <%= user.status === 'มีห้องแล้ว' ? 'selected' : '' %>>มีห้องแล้ว</option>
                                        <option value="ยังไม่มีห้อง" <%= user.status === 'ยังไม่มีห้อง' ? 'selected' : '' %>>ยังไม่มีห้อง</option>
                                    </select>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">อีเมล</label>
                                    <input type="email" value="<%= user.email %>" disabled
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100 text-gray-600">
                                    <p class="text-xs text-gray-500 mt-1">ไม่สามารถแก้ไขอีเมลได้</p>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="flex justify-end space-x-4 mt-6 pt-6 border-t">
                            <a href="/admin/users/<%= user.Accounts_id %>" 
                               class="px-6 py-2 bg-gray-500 hover:bg-gray-600 text-white rounded-lg transition-colors">
                                <i class="fas fa-times mr-2"></i>
                                ยกเลิก
                            </a>
                            <button type="submit" 
                                    class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
                                <i class="fas fa-save mr-2"></i>
                                บันทึกการเปลี่ยนแปลง
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Auto-hide flash messages after 5 seconds
        document.addEventListener('DOMContentLoaded', function() {
            const flashMessages = document.querySelectorAll('.flash-message');
            flashMessages.forEach(function(message) {
                setTimeout(function() {
                    message.style.transition = 'opacity 0.5s';
                    message.style.opacity = '0';
                    setTimeout(function() {
                        message.style.display = 'none';
                    }, 500);
                }, 5000);
            });
        });
    </script>
</body>
</html>

