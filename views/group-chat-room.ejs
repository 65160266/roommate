<!-- 
    หน้าแชทกลุ่ม
    - แชทกับสมาชิกในกลุ่ม
    - ส่งข้อความแบบ real-time
    - ดูสมาชิกและจัดการกลุ่ม
-->
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="/socket.io/socket.io.js"></script>
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/group-chat-room.css">
    <title><%= groupDetails.group_name %> - RoomMate</title>
</head>
<body class="home-container">
    <% if (!session.user.isAdmin) { %>
        <%- include('partials/homeheader') %>
    <% } %>
    
    <div class="group-chat-room-container" style="<%= session.user.isAdmin ? 'height: 100vh; margin-top: 0;' : '' %>">
        <!-- ส่วนหัวแชทกลุ่ม -->
        <div class="group-chat-header">
            <div class="group-chat-header-info">
                <a href="<%= session.user.isAdmin ? '/admin/groups' : '/group-chat' %>" class="group-chat-back">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                </a>
                <div class="group-chat-avatar">
                    <svg class="group-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                </div>
                <div class="group-chat-details">
                    <div class="group-chat-name"><%= groupDetails.group_name %></div>
                    <div class="group-chat-members-count"><%= groupDetails.member_count %> สมาชิก</div>
                </div>
            </div>
            <div class="group-chat-actions">
                <button class="group-chat-members-btn" onclick="toggleMembersSidebar()">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                    สมาชิก
                </button>
            </div>
        </div>

        <div class="group-chat-main">
            <!-- Messages Area -->
            <div class="group-messages-container" id="messages">
                <% if (messages && messages.length > 0) { %>
                    <% messages.forEach(message => { %>
                        <div class="group-message <%= message.sender_id == userId ? 'group-message-sent' : 'group-message-received' %>">
                            <div class="group-message-bubble">
                                <% if (message.sender_id != userId && message.sender_name) { %>
                                    <div class="group-message-sender"><%= message.sender_name %></div>
                                <% } %>
                                <div class="group-message-text"><%= message.message_text %></div>
                                <div class="group-message-time">
                                    <%= new Date(message.created_at).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="group-messages-empty">
                        <div class="group-messages-empty-icon">
                            <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                            </svg>
                        </div>
                        <h3 class="group-messages-empty-title">เริ่มต้นการสนทนา</h3>
                        <p class="group-messages-empty-text">ส่งข้อความแรกในกลุ่มนี้</p>
                    </div>
                <% } %>
            </div>

            <!-- Members Sidebar -->
            <div class="group-members-sidebar" id="membersSidebar">
                <div class="group-members-header">
                    <h3 class="group-members-title">สมาชิก (<%= groupDetails.member_count %>)</h3>
                    <button class="group-members-close" onclick="toggleMembersSidebar()">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
                
                
                <!-- Member Avatars Row -->
                <div class="member-avatars-row">
                    <h4 class="avatars-title">สมาชิก</h4>
                    <div class="avatars-container">
                        <% if (members && members.length > 0) { %>
                            <% members.forEach(member => { %>
                                <div class="member-avatar-item" title="<%= member.first_name %> <%= member.last_name %>" 
                                     onclick="showMemberProfile(<%= member.user_id %>)" 
                                     style="cursor: pointer;">
                                    <img src="<%= member.image || '/images/default-avatar.png' %>" 
                                         alt="<%= member.first_name %>" 
                                         class="member-avatar-img">
                                    <% if (member.user_id == userId) { %>
                                        <div class="avatar-you-badge">คุณ</div>
                                    <% } %>
                                    <% if (member.role === 'leader') { %>
                                        <div class="avatar-leader-badge">ผู้นำ</div>
                                    <% } %>
                                    <% if (groupDetails.created_by == userId && member.user_id != userId) { %>
                                        <button class="avatar-remove-btn" onclick="event.stopPropagation(); confirmRemoveMember(<%= member.user_id %>, '<%= member.first_name %>')" title="ลบสมาชิก">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                            </svg>
                                        </button>
                                    <% } %>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="no-members">
                                <p>ไม่มีสมาชิก</p>
                            </div>
                        <% } %>
                    </div>
                </div>
                
                <!-- Group Management Options -->
                <% if (!session.user.isAdmin) { %>
                <div class="group-management-options">
                    <% if (groupDetails.created_by == userId) { %>
                        <!-- Creator Options -->
                        <div class="management-section">
                            <h4 class="management-section-title">จัดการกลุ่ม</h4>
                            <div class="management-buttons">
                                <button class="management-btn edit-btn" onclick="showEditModal()">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                    </svg>
                                    แก้ไขกลุ่ม
                                </button>
                                <button class="management-btn invite-btn" onclick="showInviteModal()">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                                    </svg>
                                    เชิญสมาชิก
                                </button>
                                <button class="management-btn danger-btn" onclick="confirmDeleteGroup()">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                    </svg>
                                    ลบกลุ่ม
                                </button>
                            </div>
                        </div>
                    <% } else { %>
                        <!-- Member Options -->
                        <div class="management-section">
                            <h4 class="management-section-title">ตัวเลือก</h4>
                            <div class="management-buttons">
                                <button class="management-btn danger-btn" onclick="confirmLeaveGroup()">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                                    </svg>
                                    ออกจากกลุ่ม
                                </button>
                            </div>
                        </div>
                    <% } %>
                </div>
                <% } %>
            </div>
        </div>

        <!-- Chat Input -->
        <div class="group-chat-input-container">
            <form class="group-chat-input-form" id="messageForm">
                <input 
                    type="text" 
                    id="messageInput" 
                    class="group-chat-input" 
                    placeholder="พิมพ์ข้อความในกลุ่ม..."
                    autocomplete="off"
                    required
                >
                <button type="submit" class="group-chat-send-button" id="sendButton">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                    </svg>
                    ส่ง
                </button>
            </form>
        </div>
    </div>

    <!-- Edit Group Modal -->
    <div class="modal-overlay" id="editModal" style="display: none;">
        <div class="modal-container">
            <div class="modal-header">
                <h3 class="modal-title">แก้ไขกลุ่ม</h3>
                <button class="modal-close" onclick="closeEditModal()">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            <form id="editGroupForm">
                <div class="modal-body">
                    <div class="form-group">
                        <label for="editGroupName" class="form-label">ชื่อกลุ่ม</label>
                        <input type="text" id="editGroupName" class="form-input" value="<%= groupDetails.group_name %>" required>
                    </div>
                    <div class="form-group">
                        <label for="editGroupDescription" class="form-label">คำอธิบาย</label>
                        <textarea id="editGroupDescription" class="form-textarea" rows="3"><%= groupDetails.description || '' %></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel" onclick="closeEditModal()">ยกเลิก</button>
                    <button type="submit" class="btn-save">บันทึก</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Invite Members Modal -->
    <div class="modal-overlay" id="inviteModal" style="display: none;">
        <div class="modal-container">
            <div class="modal-header">
                <h3 class="modal-title">เชิญสมาชิก</h3>
                <button class="modal-close" onclick="closeInviteModal()">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="invite-members-list" id="inviteMembersList">
                    <!-- Members will be loaded here -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" onclick="closeInviteModal()">ยกเลิก</button>
                <button type="button" class="btn-save" onclick="inviteSelectedMembers()">เชิญสมาชิก</button>
            </div>
        </div>
    </div>

    <script>
        const groupId = <%= groupDetails.group_id %>;
        const userId = <%= userId %>;
        const messagesDiv = document.getElementById('messages');
        const messageForm = document.getElementById('messageForm');
        const messageInput = document.getElementById('messageInput');
        const sendButton = document.getElementById('sendButton');
        const membersSidebar = document.getElementById('membersSidebar');

        // Initialize Socket.IO
        const socket = io();

        // Join group chat room
        socket.emit('join-group-chat', groupId);

        // Listen for new messages
        socket.on('new-group-message', (data) => {
            if (data.group_id == groupId) {
                addMessageToUI(data);
                scrollToBottom();
            }
        });

        // Send message
        messageForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const messageText = messageInput.value.trim();
            if (!messageText) return;

            console.log('Sending message:', { groupId, messageText });
            sendButton.disabled = true;
            
            try {
                const response = await fetch('/group-chat/send-message', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `group_id=${groupId}&message_text=${encodeURIComponent(messageText)}`
                });

                const responseData = await response.json();
                console.log('Response:', responseData);

                if (response.ok && responseData.success) {
                    messageInput.value = '';
                    messageInput.focus();
                } else {
                    alert('ไม่สามารถส่งข้อความได้: ' + (responseData.error || 'กรุณาลองใหม่'));
                }
            } catch (error) {
                console.error('Error:', error);
                alert('เกิดข้อผิดพลาด: ' + error.message);
            } finally {
                sendButton.disabled = false;
            }
        });

        // Add message to UI
        function addMessageToUI(message) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `group-message ${message.sender_id == userId ? 'group-message-sent' : 'group-message-received'}`;
            
            const bubble = document.createElement('div');
            bubble.className = 'group-message-bubble';
            
            if (message.sender_id != userId && message.sender_name) {
                const sender = document.createElement('div');
                sender.className = 'group-message-sender';
                sender.textContent = message.sender_name;
                bubble.appendChild(sender);
            }
            
            const text = document.createElement('div');
            text.className = 'group-message-text';
            text.textContent = message.message_text;
            bubble.appendChild(text);
            
            const time = document.createElement('div');
            time.className = 'group-message-time';
            time.textContent = new Date(message.created_at).toLocaleTimeString('th-TH', { 
                hour: '2-digit', 
                minute: '2-digit' 
            });
            bubble.appendChild(time);
            
            messageDiv.appendChild(bubble);
            messagesDiv.appendChild(messageDiv);
        }

        // Toggle members sidebar
        function toggleMembersSidebar() {
            membersSidebar.classList.toggle('active');
        }
        
        // Toggle group management menu
        function toggleGroupManagement() {
            const menu = document.getElementById('groupManagementMenu');
            menu.classList.toggle('show');
        }
        
        // Close dropdowns when clicking outside
        document.addEventListener('click', function(e) {
            const sidebar = document.getElementById('membersSidebar');
            const membersBtn = document.querySelector('.group-chat-members-btn');
            const managementMenu = document.getElementById('groupManagementMenu');
            const managementBtn = document.querySelector('.group-management-btn');
            
            if (!sidebar.contains(e.target) && !membersBtn.contains(e.target)) {
                sidebar.classList.remove('active');
            }
            
            if (!managementMenu.contains(e.target) && !managementBtn.contains(e.target)) {
                managementMenu.classList.remove('show');
            }
        });
        
        // Confirm delete group
        function confirmDeleteGroup() {
            if (confirm('คุณแน่ใจหรือไม่ที่จะลบกลุ่มนี้? การดำเนินการนี้ไม่สามารถยกเลิกได้')) {
                fetch(`/group-chat/${groupId}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('ลบกลุ่มสำเร็จแล้ว');
                        window.location.href = '/group-chat';
                    } else {
                        alert('เกิดข้อผิดพลาด: ' + data.error);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('เกิดข้อผิดพลาดในการลบกลุ่ม');
                });
            }
        }
        
        // Confirm leave group
        function confirmLeaveGroup() {
            if (confirm('คุณแน่ใจหรือไม่ที่จะออกจากกลุ่มนี้?')) {
                fetch(`/group-chat/${groupId}/leave`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('ออกจากกลุ่มสำเร็จแล้ว');
                        window.location.href = '/group-chat';
                    } else {
                        alert('เกิดข้อผิดพลาด: ' + data.error);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('เกิดข้อผิดพลาดในการออกจากกลุ่ม');
                });
            }
        }
        
        // Show edit modal
        function showEditModal() {
            document.getElementById('editModal').style.display = 'flex';
        }
        
        // Close edit modal
        function closeEditModal() {
            document.getElementById('editModal').style.display = 'none';
        }
        
        // Show invite modal
        function showInviteModal() {
            loadInviteMembers();
            document.getElementById('inviteModal').style.display = 'flex';
        }
        
        // Close invite modal
        function closeInviteModal() {
            document.getElementById('inviteModal').style.display = 'none';
        }
        
        // Load invite members
        async function loadInviteMembers() {
            try {
                const response = await fetch(`/group-chat/${groupId}/invite-members`);
                const data = await response.json();
                
                const container = document.getElementById('inviteMembersList');
                if (data.success && data.members.length > 0) {
                    container.innerHTML = data.members.map(member => `
                        <div class="invite-member-item" onclick="toggleMemberSelection(${member.Accounts_id})">
                            <img src="${member.image || '/images/default-avatar.png'}" 
                                 alt="${member.first_name}" class="invite-member-avatar">
                            <div class="invite-member-info">
                                <div class="invite-member-name">${member.first_name} ${member.last_name}</div>
                                <div class="invite-member-details">
                                    อายุ ${member.age} ปี • ${member.faculty_name || 'ไม่ระบุ'} • ${member.majors_name || 'ไม่ระบุ'}
                                </div>
                            </div>
                            <input type="checkbox" class="invite-member-checkbox" id="member-${member.Accounts_id}" 
                                   value="${member.Accounts_id}" style="display: none;">
                        </div>
                    `).join('');
                } else {
                    container.innerHTML = '<p style="text-align: center; color: #6b7280; padding: 2rem;">ไม่มีเพื่อนที่แมทแล้วสำหรับเชิญเข้าร่วมกลุ่ม</p>';
                }
            } catch (error) {
                console.error('Error loading invite members:', error);
                document.getElementById('inviteMembersList').innerHTML = '<p style="text-align: center; color: #dc2626; padding: 2rem;">เกิดข้อผิดพลาดในการโหลดข้อมูล</p>';
            }
        }
        
        // Toggle member selection
        function toggleMemberSelection(memberId) {
            const item = event.currentTarget;
            const checkbox = item.querySelector('.invite-member-checkbox');
            
            checkbox.checked = !checkbox.checked;
            item.classList.toggle('selected', checkbox.checked);
        }
        
        // Invite selected members
        async function inviteSelectedMembers() {
            const checkboxes = document.querySelectorAll('.invite-member-checkbox:checked');
            const memberIds = Array.from(checkboxes).map(cb => cb.value);
            
            if (memberIds.length === 0) {
                alert('กรุณาเลือกสมาชิกที่ต้องการเชิญ');
                return;
            }
            
            try {
                const response = await fetch(`/group-chat/${groupId}/add-members`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        member_ids: memberIds
                    })
                });
                
                const data = await response.json();
                if (data.success) {
                    alert('เชิญสมาชิกสำเร็จแล้ว');
                    closeInviteModal();
                    location.reload();
                } else {
                    alert('เกิดข้อผิดพลาด: ' + data.error);
                }
            } catch (error) {
                console.error('Error inviting members:', error);
                alert('เกิดข้อผิดพลาดในการเชิญสมาชิก');
            }
        }
        
        // Confirm remove member
        function confirmRemoveMember(memberId, memberName) {
            if (confirm(`คุณแน่ใจหรือไม่ที่จะลบ ${memberName} ออกจากกลุ่ม?`)) {
                fetch(`/group-chat/${groupId}/remove-member`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        user_id: memberId
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('ลบสมาชิกสำเร็จแล้ว');
                        location.reload();
                    } else {
                        alert('เกิดข้อผิดพลาด: ' + data.error);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('เกิดข้อผิดพลาดในการลบสมาชิก');
                });
            }
        }

        // Scroll to bottom
        function scrollToBottom() {
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
        }
        
        // Handle edit group form
        document.getElementById('editGroupForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const groupName = document.getElementById('editGroupName').value;
            const description = document.getElementById('editGroupDescription').value;
            
            try {
                const response = await fetch(`/group-chat/${groupId}/edit`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        group_name: groupName,
                        description: description
                    })
                });
                
                const data = await response.json();
                if (data.success) {
                    alert('แก้ไขกลุ่มสำเร็จแล้ว');
                    closeEditModal();
                    location.reload();
                } else {
                    alert('เกิดข้อผิดพลาด: ' + data.error);
                }
            } catch (error) {
                console.error('Error updating group:', error);
                alert('เกิดข้อผิดพลาดในการแก้ไขกลุ่ม');
            }
        });

        // Show member profile modal
        async function showMemberProfile(userId) {
            try {
                const response = await fetch(`/api/user-profile/${userId}`);
                const data = await response.json();
                
                if (data.success) {
                    const user = data.user;
                    const modalHTML = `
                        <div id="memberProfileModal" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 9999;">
                            <div style="background: white; border-radius: 12px; padding: 24px; max-width: 500px; width: 90%; max-height: 80vh; overflow-y: auto;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                                    <h2 style="font-size: 24px; font-weight: bold; color: #1f2937;">ข้อมูลสมาชิก</h2>
                                    <button onclick="closeMemberProfile()" style="background: #ef4444; color: white; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: none; cursor: pointer;">
                                        <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                        </svg>
                                    </button>
                                </div>
                                
                                <div style="text-align: center; margin-bottom: 20px;">
                                    <img src="${user.image || '/images/default-avatar.png'}" alt="${user.first_name}" 
                                         style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover; margin: 0 auto; border: 4px solid #3b82f6;">
                                </div>
                                
                                <div style="space-y: 12px;">
                                    <div style="padding: 12px; background: #f3f4f6; border-radius: 8px; margin-bottom: 12px;">
                                        <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">ชื่อ-นามสกุล</div>
                                        <div style="font-size: 18px; font-weight: 600; color: #1f2937;">${user.first_name} ${user.last_name}</div>
                                    </div>
                                    
                                    ${user.nickname ? `
                                    <div style="padding: 12px; background: #f3f4f6; border-radius: 8px; margin-bottom: 12px;">
                                        <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">ชื่อเล่น</div>
                                        <div style="font-size: 16px; font-weight: 500; color: #1f2937;">${user.nickname}</div>
                                    </div>
                                    ` : ''}
                                    
                                    ${user.age ? `
                                    <div style="padding: 12px; background: #f3f4f6; border-radius: 8px; margin-bottom: 12px;">
                                        <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">อายุ</div>
                                        <div style="font-size: 16px; font-weight: 500; color: #1f2937;">${user.age} ปี</div>
                                    </div>
                                    ` : ''}
                                    
                                    ${user.gender ? `
                                    <div style="padding: 12px; background: #f3f4f6; border-radius: 8px; margin-bottom: 12px;">
                                        <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">เพศ</div>
                                        <div style="font-size: 16px; font-weight: 500; color: #1f2937;">${user.gender === 'male' || user.gender === 'ชาย' ? 'ชาย' : user.gender === 'female' || user.gender === 'หญิง' ? 'หญิง' : user.gender === 'other' || user.gender === 'อื่นๆ' ? 'อื่นๆ' : user.gender}</div>
                                    </div>
                                    ` : ''}
                                    
                                    ${user.faculty_name ? `
                                    <div style="padding: 12px; background: #f3f4f6; border-radius: 8px; margin-bottom: 12px;">
                                        <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">คณะ</div>
                                        <div style="font-size: 16px; font-weight: 500; color: #1f2937;">${user.faculty_name}</div>
                                    </div>
                                    ` : ''}
                                    
                                    ${user.majors_name ? `
                                    <div style="padding: 12px; background: #f3f4f6; border-radius: 8px; margin-bottom: 12px;">
                                        <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">สาขา</div>
                                        <div style="font-size: 16px; font-weight: 500; color: #1f2937;">${user.majors_name}</div>
                                    </div>
                                    ` : ''}
                                    
                                    ${user.year ? `
                                    <div style="padding: 12px; background: #f3f4f6; border-radius: 8px; margin-bottom: 12px;">
                                        <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">ชั้นปี</div>
                                        <div style="font-size: 16px; font-weight: 500; color: #1f2937;">${user.year}</div>
                                    </div>
                                    ` : ''}
                                    
                                    ${user.personalities && user.personalities.length > 0 ? `
                                    <div style="padding: 12px; background: #f3f4f6; border-radius: 8px; margin-bottom: 12px;">
                                        <div style="font-size: 14px; color: #6b7280; margin-bottom: 8px;">บุคลิกภาพ</div>
                                        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                                            ${user.personalities.map(p => `<span style="background: #3b82f6; color: white; padding: 4px 12px; border-radius: 16px; font-size: 14px;">${p}</span>`).join('')}
                                        </div>
                                    </div>
                                    ` : ''}
                                </div>
                            </div>
                        </div>
                    `;
                    
                    document.body.insertAdjacentHTML('beforeend', modalHTML);
                } else {
                    alert('ไม่สามารถโหลดข้อมูลสมาชิกได้');
                }
            } catch (error) {
                console.error('Error loading member profile:', error);
                alert('เกิดข้อผิดพลาดในการโหลดข้อมูลสมาชิก');
            }
        }
        
        function closeMemberProfile() {
            const modal = document.getElementById('memberProfileModal');
            if (modal) {
                modal.remove();
            }
        }

        // Initial scroll to bottom
        window.addEventListener('load', () => {
            scrollToBottom();
            messageInput.focus();
        });
    </script>
</body>
</html>
