<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="css/layout.css">
    <link rel="stylesheet" href="css/styles.css">
    <link rel="stylesheet" href="css/match.css">
    <title><%= title %> - RoomMate</title>
    <style>
        .chat-container {
            height: calc(100vh - 200px);
            max-height: 600px;
        }
        .message-bubble {
            max-width: 70%;
            word-wrap: break-word;
        }
        .message-sent {
            background-color: #3B82F6;
            color: white;
            border-bottom-right-radius: 0;
        }
        .message-received {
            background-color: #E5E7EB;
            color: #1F2937;
            border-bottom-left-radius: 0;
        }
        .member-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
        }
    </style>
</head>
<body class="bg-gray-100">
    <%- include('partials/homeheader') %>

    <!-- Flash Messages -->
    <% if (typeof session !== 'undefined' && session.flash) { %>
        <% if (session.flash.success) { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4 mx-4">
                <%= session.flash.success %>
            </div>
        <% } %>
        <% if (session.flash.error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 mx-4">
                <%= session.flash.error %>
            </div>
        <% } %>
    <% } %>

    <div class="container mx-auto p-4">
        <div class="bg-white rounded-lg shadow-lg overflow-hidden">
            <!-- Group Chat Header -->
            <div class="bg-gradient-to-r from-blue-600 to-purple-600 text-white p-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <a href="/group-chat" class="text-white hover:text-blue-200">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                            </svg>
                        </a>
                        <div class="w-10 h-10 bg-white bg-opacity-20 rounded-full flex items-center justify-center text-white font-bold text-lg">
                            <%= groupDetails.group_name.charAt(0).toUpperCase() %>
                        </div>
                        <div>
                            <h2 class="text-xl font-semibold"><%= groupDetails.group_name %></h2>
                            <p class="text-sm text-blue-100">
                                <%= groupMembers.length %> members
                                <% if (groupDetails.user_role === 'admin') { %>
                                    • You are admin
                                <% } %>
                            </p>
                        </div>
                    </div>
                    <div class="flex items-center space-x-2">
                        <button onclick="toggleMembers()" class="text-white hover:text-blue-200 p-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                            </svg>
                        </button>
                        <% if (groupDetails.user_role === 'admin') { %>
                            <button onclick="toggleGroupSettings()" class="text-white hover:text-blue-200 p-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                            </button>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Members Panel (Hidden by default) -->
            <div id="membersPanel" class="hidden bg-gray-50 border-b border-gray-200 p-4">
                <h3 class="text-lg font-semibold text-gray-800 mb-3">Group Members</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <% groupMembers.forEach(member => { %>
                        <div class="flex items-center space-x-3 p-2 bg-white rounded-lg">
                            <img src="<%= member.user_image || '/images/default-avatar.png' %>" 
                                 alt="<%= member.user_name %>" 
                                 class="member-avatar">
                            <div class="flex-1">
                                <p class="font-medium text-gray-900">
                                    <%= member.user_name %>
                                    <% if (member.role === 'admin') { %>
                                        <span class="text-xs bg-yellow-100 text-yellow-800 px-2 py-1 rounded-full ml-2">Admin</span>
                                    <% } %>
                                </p>
                                <p class="text-sm text-gray-500">
                                    Joined <%= new Date(member.joined_at).toLocaleDateString() %>
                                </p>
                            </div>
                            <% if (groupDetails.user_role === 'admin' && member.user_id !== currentUser.Accounts_id) { %>
                                <button onclick="removeMember(<%= member.user_id %>)" 
                                        class="text-red-500 hover:text-red-700 p-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                </button>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
                <% if (groupDetails.user_role === 'admin') { %>
                    <div class="mt-4 pt-4 border-t border-gray-200">
                        <button onclick="showAddMemberModal()" 
                                class="w-full px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
                            ➕ Add Member
                        </button>
                    </div>
                <% } %>
            </div>

            <!-- Group Settings Panel (Hidden by default) -->
            <div id="groupSettingsPanel" class="hidden bg-gray-50 border-b border-gray-200 p-4">
                <h3 class="text-lg font-semibold text-gray-800 mb-3">Group Settings</h3>
                <form action="/group-chat/<%= groupDetails.group_id %>/update" method="POST" class="space-y-4">
                    <div>
                        <label for="group_name" class="block text-sm font-medium text-gray-700 mb-1">
                            Group Name
                        </label>
                        <input type="text" 
                               id="group_name" 
                               name="group_name" 
                               value="<%= groupDetails.group_name %>"
                               required
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    <div>
                        <label for="description" class="block text-sm font-medium text-gray-700 mb-1">
                            Description
                        </label>
                        <textarea id="description" 
                                  name="description" 
                                  rows="3"
                                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"><%= groupDetails.description || '' %></textarea>
                    </div>
                    <div class="flex items-center justify-end space-x-2">
                        <button type="button" 
                                onclick="toggleGroupSettings()"
                                class="px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50">
                            Cancel
                        </button>
                        <button type="submit" 
                                class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>

            <!-- Chat Messages Container -->
            <div id="chatContainer" class="chat-container p-4 overflow-y-auto flex flex-col space-y-4">
                <input type="hidden" id="groupId" value="<%= groupDetails.group_id %>">
                <% if (messages && messages.length > 0) { %>
                    <% messages.forEach(message => { %>
                        <div class="flex <%= message.sender_id === currentUser.Accounts_id ? 'justify-end' : 'justify-start' %>">
                            <div class="message-bubble px-4 py-2 rounded-lg <%= message.sender_id === currentUser.Accounts_id ? 'message-sent' : 'message-received' %>">
                                <% if (message.sender_id !== currentUser.Accounts_id) { %>
                                    <p class="text-xs font-medium mb-1 opacity-70"><%= message.sender_name %></p>
                                <% } %>
                                <p class="text-sm"><%= message.message_text %></p>
                                <p class="text-xs mt-1 opacity-70"><%= new Date(message.created_at).toLocaleTimeString() %></p>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="text-center text-gray-500 py-10">
                        <p>No messages yet. Start the conversation!</p>
                    </div>
                <% } %>
            </div>

            <!-- Message Input -->
            <div class="p-4 border-t border-gray-200">
                <form id="messageForm" class="flex">
                    <input type="text" 
                           id="messageInput" 
                           placeholder="Type your message..." 
                           class="flex-1 p-2 border border-gray-300 rounded-l-md focus:outline-none focus:ring-2 focus:ring-blue-400"
                           maxlength="1000"
                           required>
                    <button type="submit" 
                            class="bg-blue-600 text-white px-4 py-2 rounded-r-md hover:bg-blue-700 transition-colors">
                        Send
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Add Member Modal -->
    <div id="addMemberModal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
        <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
            <div class="mt-3">
                <h3 class="text-lg font-medium text-gray-900 mb-4">Add Member to Group</h3>
                <div id="availableUsers" class="max-h-60 overflow-y-auto space-y-2">
                    <!-- Users will be loaded here -->
                </div>
                <div class="flex items-center justify-end space-x-2 mt-4">
                    <button onclick="hideAddMemberModal()" 
                            class="px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const groupId = document.getElementById('groupId').value;
        const messageForm = document.getElementById('messageForm');
        const messageInput = document.getElementById('messageInput');
        const chatContainer = document.getElementById('chatContainer');

        // Auto-scroll to bottom
        function scrollToBottom() {
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }

        // Toggle members panel
        function toggleMembers() {
            const panel = document.getElementById('membersPanel');
            panel.classList.toggle('hidden');
            // Hide settings panel if open
            document.getElementById('groupSettingsPanel').classList.add('hidden');
        }

        // Toggle group settings panel
        function toggleGroupSettings() {
            const panel = document.getElementById('groupSettingsPanel');
            panel.classList.toggle('hidden');
            // Hide members panel if open
            document.getElementById('membersPanel').classList.add('hidden');
        }

        // Show add member modal
        function showAddMemberModal() {
            const modal = document.getElementById('addMemberModal');
            const usersContainer = document.getElementById('availableUsers');
            
            // Load available users
            fetch(`/group-chat/${groupId}/available-users`)
                .then(response => response.json())
                .then(users => {
                    usersContainer.innerHTML = '';
                    if (users.length === 0) {
                        usersContainer.innerHTML = '<p class="text-gray-500 text-center">No available users to add</p>';
                    } else {
                        users.forEach(user => {
                            const userDiv = document.createElement('div');
                            userDiv.className = 'flex items-center justify-between p-2 bg-gray-50 rounded-lg';
                            userDiv.innerHTML = `
                                <div class="flex items-center space-x-2">
                                    <img src="${user.image || '/images/default-avatar.png'}" 
                                         alt="${user.first_name} ${user.last_name}" 
                                         class="w-8 h-8 rounded-full object-cover">
                                    <span class="text-sm font-medium">${user.first_name} ${user.last_name}</span>
                                </div>
                                <button onclick="addMember(${user.Accounts_id})" 
                                        class="px-3 py-1 bg-blue-600 text-white text-xs rounded hover:bg-blue-700">
                                    Add
                                </button>
                            `;
                            usersContainer.appendChild(userDiv);
                        });
                    }
                })
                .catch(error => {
                    console.error('Error loading users:', error);
                    usersContainer.innerHTML = '<p class="text-red-500 text-center">Error loading users</p>';
                });
            
            modal.classList.remove('hidden');
        }

        // Hide add member modal
        function hideAddMemberModal() {
            document.getElementById('addMemberModal').classList.add('hidden');
        }

        // Add member to group
        function addMember(userId) {
            fetch(`/group-chat/${groupId}/add-member`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `user_id=${userId}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Member added successfully!');
                    hideAddMemberModal();
                    // Reload page to show new member
                    window.location.reload();
                } else {
                    alert('Error adding member: ' + data.error);
                }
            })
            .catch(error => {
                console.error('Error adding member:', error);
                alert('Error adding member');
            });
        }

        // Remove member from group
        function removeMember(userId) {
            if (confirm('Are you sure you want to remove this member?')) {
                fetch(`/group-chat/${groupId}/remove-member`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `user_id=${userId}`
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Member removed successfully!');
                        // Reload page to update member list
                        window.location.reload();
                    } else {
                        alert('Error removing member: ' + data.error);
                    }
                })
                .catch(error => {
                    console.error('Error removing member:', error);
                    alert('Error removing member');
                });
            }
        }

        // Send message
        messageForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const messageText = messageInput.value.trim();
            if (!messageText) return;

            // Disable form while sending
            messageForm.querySelector('button').disabled = true;
            messageInput.disabled = true;

            try {
                const response = await fetch(`/group-chat/${groupId}/message`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `group_id=${groupId}&message_text=${encodeURIComponent(messageText)}`
                });

                const result = await response.json();

                if (result.success) {
                    // Reload page to show new message
                    window.location.reload();
                } else {
                    alert('Error sending message: ' + result.error);
                }
            } catch (error) {
                console.error('Error sending message:', error);
                alert('Error sending message');
            } finally {
                // Re-enable form
                messageForm.querySelector('button').disabled = false;
                messageInput.disabled = false;
                messageInput.focus();
            }
        });

        // Auto-hide flash messages
        setTimeout(() => {
            const flashMessages = document.querySelectorAll('.bg-green-100, .bg-red-100');
            flashMessages.forEach(msg => {
                msg.style.transition = 'opacity 0.5s';
                msg.style.opacity = '0';
                setTimeout(() => msg.remove(), 500);
            });
        }, 5000);

        // Initial scroll to bottom
        scrollToBottom();
    </script>
</body>
</html>

