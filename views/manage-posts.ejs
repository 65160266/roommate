<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/post-management.css">
    <title>จัดการโพสต์ - RoomMate</title>
</head>
<body class="home-container">
    <%- include('partials/homeheader') %>

    <!-- Flash Messages -->
    <% if (typeof session !== 'undefined' && session.flash) { %>
        <% if (session.flash.success) { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4 mx-4">
                <%= session.flash.success %>
            </div>
        <% } %>
        <% if (session.flash.error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 mx-4">
                <%= session.flash.error %>
            </div>
        <% } %>
    <% } %>

    <div class="container mx-auto mt-6 px-4">
        <div class="bg-white rounded-lg shadow-lg p-6">
            <div class="flex items-center justify-between mb-6">
                <h1 class="text-2xl font-bold text-gray-800">จัดการโพสต์ของคุณ</h1>
                <a href="/post/create" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    สร้างโพสต์ใหม่
                </a>
            </div>

            <% if (posts && posts.length > 0) { %>
                <div class="space-y-4">
                    <% posts.forEach(post => { %>
                        <div class="post-card bg-gray-50 rounded-lg p-4 border border-gray-200">
                            <div class="flex items-start justify-between">
                                <div class="flex-1">
                                    <div class="flex items-center mb-2">
                                        <img src="<%= post.image || '/images/default-avatar.png' %>" 
                                             alt="<%= post.first_name %>" 
                                             class="w-8 h-8 rounded-full mr-3">
                                        <div>
                                            <h3 class="font-semibold text-gray-800">
                                                <%= post.first_name %> <%= post.last_name %>
                                            </h3>
                                            <p class="text-sm text-gray-500">(<%= post.nickname %>)</p>
                                        </div>
                                    </div>
                                    
                                    <div class="post-content mb-3">
                                        <% if (post.content) { %>
                                            <p class="text-gray-700"><%= post.content %></p>
                                        <% } else { %>
                                            <p class="text-gray-500 italic">ไม่มีเนื้อหา</p>
                                        <% } %>
                                    </div>
                                    
                                    <div class="text-sm text-gray-500">
                                        <span>สร้างเมื่อ: <%= new Date(post.created_at).toLocaleString('th-TH') %></span>
                                        <% if (post.updated_at && post.updated_at !== post.created_at) { %>
                                            <span class="ml-4">แก้ไขเมื่อ: <%= new Date(post.updated_at).toLocaleString('th-TH') %></span>
                                        <% } %>
                                    </div>
                                </div>
                                
                                <div class="flex space-x-2 ml-4">
                                    <a href="/post/edit/<%= post.Post_id %>" 
                                       class="inline-flex items-center px-3 py-1 bg-yellow-500 text-white rounded hover:bg-yellow-600 transition-colors text-sm">
                                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                        </svg>
                                        แก้ไข
                                    </a>
                                    
                                    <form action="/post/delete/<%= post.Post_id %>" method="POST" class="inline" 
                                          onsubmit="return confirm('คุณแน่ใจหรือไม่ที่จะลบโพสต์นี้?')">
                                        <button type="submit" 
                                                class="inline-flex items-center px-3 py-1 bg-red-500 text-white rounded hover:bg-red-600 transition-colors text-sm">
                                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                            ลบ
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="text-center py-12">
                    <div class="text-gray-400 mb-4">
                        <svg class="w-16 h-16 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                    </div>
                    <h3 class="text-lg font-medium text-gray-600 mb-2">ยังไม่มีโพสต์</h3>
                    <p class="text-gray-500 mb-4">เริ่มต้นสร้างโพสต์แรกของคุณ</p>
                    <a href="/post/create" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        สร้างโพสต์ใหม่
                    </a>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>

