<!-- 
    หน้าจับคู่ที่รอดำเนินการ
    - แสดงคำขอจับคู่ที่รอตอบกลับ
    - แสดงคำขอจับคู่ที่ส่งไป
    - ยืนยัน/ปฏิเสธ/ยกเลิกคำขอ
-->
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/home.css">
    <title>In-Progress Matches</title>
</head>
<body class="home-container">
    <%- include('partials/homeheader') %>

    <!-- เนื้อหาหลัก -->
    <div class="container mx-auto px-4 py-6">
        <!-- Header Section -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between mb-8">
            <!-- Left Side - Navigation Tabs -->
            <div class="flex flex-col sm:flex-row gap-4 mb-6 lg:mb-0">
                <a href="/home" class="nav-tab">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                    หน้าแรก
                </a>
                <button class="nav-tab active">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    อยู่ระหว่างดำเนินการจับคู่
                </button>
                <a href="/match/matched" class="nav-tab">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                    </svg>
                    จับคู่สำเร็จ
                </a>
            </div>
        </div>

        <!-- Content -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Pending Matches -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-bold text-gray-800 flex items-center">
                        <svg class="w-5 h-5 text-orange-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        รอการตอบกลับ
                    </h2>
                    <span class="bg-orange-100 text-orange-800 px-2 py-1 rounded-full text-sm font-medium">
                        <%= pendingMatches ? pendingMatches.length : 0 %>
                    </span>
                </div>
                
                <% if (pendingMatches && pendingMatches.length > 0) { %>
                    <div class="space-y-3">
                        <% for (var i = 0; i < pendingMatches.length; i++) { %>
                            <% var match = pendingMatches[i]; %>
                            <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                                <div class="flex items-center space-x-3">
                                    <img src="<%= match.image || '/images/default-avatar.png' %>" alt="<%= match.first_name %>" class="w-10 h-10 rounded-full object-cover">
                                    <div class="flex-1 min-w-0">
                                        <h3 class="text-sm font-medium text-gray-900 truncate">
                                            <%= match.first_name %> <%= match.last_name %>
                                        </h3>
                                        <p class="text-xs text-gray-500 flex items-center">
                                            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                            </svg>
                                            อายุ <%= match.age %> ปี
                                        </p>
                                        <p class="text-xs text-gray-500 flex items-center">
                                            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                            </svg>
                                            <%= match.faculty_name || 'ไม่ระบุ' %>
                                        </p>
                                    </div>
                                </div>
                                <div class="mt-3 flex space-x-2">
                                    <button onclick="confirmMatch('<%= match.match_id %>')" class="flex-1 bg-green-500 text-white px-3 py-2 rounded-md text-sm font-medium hover:bg-green-600 transition-colors">
                                        ยอมรับ
                                    </button>
                                    <button onclick="rejectMatch('<%= match.match_id %>')" class="flex-1 bg-red-500 text-white px-3 py-2 rounded-md text-sm font-medium hover:bg-red-600 transition-colors">
                                        ปฏิเสธ
                                    </button>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="text-center py-8">
                        <svg class="w-12 h-12 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <h3 class="text-lg font-medium text-gray-600 mb-2">ไม่มีคำขอจับคู่ที่รอการตอบกลับ</h3>
                        <p class="text-gray-500">เมื่อมีคนส่งคำขอจับคู่มาจะแสดงที่นี่</p>
                    </div>
                <% } %>
            </div>

            <!-- Sent Matches -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-bold text-gray-800 flex items-center">
                        <svg class="w-5 h-5 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                        </svg>
                        คำขอที่ส่งไป
                    </h2>
                    <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded-full text-sm font-medium">
                        <%= sentMatches ? sentMatches.length : 0 %>
                    </span>
                </div>
                
                <% if (sentMatches && sentMatches.length > 0) { %>
                    <div class="space-y-3">
                        <% for (var i = 0; i < sentMatches.length; i++) { %>
                            <% var match = sentMatches[i]; %>
                            <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                                <div class="flex items-center space-x-3">
                                    <img src="<%= match.image || '/images/default-avatar.png' %>" alt="<%= match.first_name %>" class="w-10 h-10 rounded-full object-cover">
                                    <div class="flex-1 min-w-0">
                                        <h3 class="text-sm font-medium text-gray-900 truncate">
                                            <%= match.first_name %> <%= match.last_name %>
                                        </h3>
                                        <p class="text-xs text-gray-500 flex items-center">
                                            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                            </svg>
                                            อายุ <%= match.age %> ปี
                                        </p>
                                        <p class="text-xs text-gray-500 flex items-center">
                                            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                            </svg>
                                            <%= match.faculty_name || 'ไม่ระบุ' %>
                                        </p>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <div class="bg-blue-100 text-blue-800 px-3 py-2 rounded-md text-center text-sm font-medium">
                                        รอการตอบกลับ
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="text-center py-8">
                        <svg class="w-12 h-12 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                        </svg>
                        <h3 class="text-lg font-medium text-gray-600 mb-2">ยังไม่ได้ส่งคำขอจับคู่</h3>
                        <p class="text-gray-500 mb-4">ไปที่หน้าแรกเพื่อค้นหาเพื่อนร่วมห้อง</p>
                        <a href="/home" class="inline-flex items-center px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                            ไปค้นหาเพื่อนร่วมห้อง
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        function confirmMatch(matchId) {
            if (confirm('ยืนยันการจับคู่?')) {
                fetch('/match/' + matchId + '/confirm', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(function(response) {
                    return response.json();
                })
                .then(function(data) {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('เกิดข้อผิดพลาด: ' + data.message);
                    }
                })
                .catch(function(error) {
                    console.error('Error:', error);
                    alert('เกิดข้อผิดพลาด');
                });
            }
        }

        function rejectMatch(matchId) {
            if (confirm('ปฏิเสธการจับคู่?')) {
                fetch('/match/' + matchId + '/reject', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(function(response) {
                    return response.json();
                })
                .then(function(data) {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('เกิดข้อผิดพลาด: ' + data.message);
                    }
                })
                .catch(function(error) {
                    console.error('Error:', error);
                    alert('เกิดข้อผิดพลาด');
                });
            }
        }
    </script>
</body>
</html>