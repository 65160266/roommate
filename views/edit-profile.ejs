<!-- 
    หน้าแก้ไขโปรไฟล์
    - แก้ไขข้อมูลส่วนตัว
    - เปลี่ยนรูปโปรไฟล์
    - อัปเดตบุคลิกภาพ
-->
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/accounts.css">
    <title>แก้ไขโปรไฟล์ - RoomMate</title>
</head>

<body class="home-container">
  <%- include('partials/homeheader') %>

    <div class="accounts-container">
        <div class="accounts-card">
            <div class="accounts-header">
                <h1 class="accounts-title">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                    แก้ไขข้อมูลส่วนตัว
                </h1>
                <p class="accounts-subtitle">แก้ไขข้อมูลส่วนตัวของคุณ</p>
        </div>

            <form action="/update/accounts" method="POST" enctype="multipart/form-data">

                <!-- Profile Image Section -->
                <div class="profile-image-section">
                    <div class="profile-image-container">
                        <div class="profile-image-preview" id="imagePreview">
                            <% if (userData.image) { %>
                                <img src="<%= userData.image %>" alt="Profile Image" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">
                            <% } else { %>
                                <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                </svg>
                            <% } %>
                        </div>
                        <div class="profile-image-upload" onclick="document.getElementById('imageInput').click()">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                            </svg>
                        </div>
                        <input type="file" id="imageInput" name="image" class="profile-image-input" accept="image/*">
                    </div>
                    <p class="profile-image-label">คลิกเพื่อเปลี่ยนรูปโปรไฟล์</p>
        </div>

                <!-- Personal Information Section -->
                <div class="form-section">
                    <h3 class="form-section-title">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        ข้อมูลส่วนตัว
                    </h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="first_name" class="form-label required">ชื่อ</label>
                            <input type="text" id="first_name" name="first_name" value="<%= userData.first_name %>" class="form-input" placeholder="กรุณากรอกชื่อ" required>
                        </div>
                        <div class="form-group">
                            <label for="last_name" class="form-label required">นามสกุล</label>
                            <input type="text" id="last_name" name="last_name" value="<%= userData.last_name %>" class="form-input" placeholder="กรุณากรอกนามสกุล" required>
                        </div>
                        <div class="form-group">
                            <label for="nickname" class="form-label required">ชื่อเล่น</label>
                            <input type="text" id="nickname" name="nickname" value="<%= userData.nickname %>" class="form-input" placeholder="กรุณากรอกชื่อเล่น" required>
                        </div>
                        <div class="form-group">
                            <label for="student_id" class="form-label required">รหัสนักศึกษา</label>
                            <input type="text" id="student_id" name="student_id" value="<%= userData.student_id %>" class="form-input" placeholder="กรุณากรอกรหัสนักศึกษา (เช่น 65xxxxxxxx)" required maxlength="10">
                        </div>
                        <div class="form-group">
                            <label for="birthdate" class="form-label required">วันเดือนปีเกิด</label>
                            <input type="date" id="birthdate" name="birthdate" class="form-input" required>
                            <input type="hidden" id="age" name="age" value="<%= userData.age || '' %>">
                        </div>
                        <div class="form-group">
                            <label for="year" class="form-label required">ปีการศึกษา</label>
                            <input type="text" id="year" name="year" value="<%= userData.year %>" class="form-input" placeholder="คำนวณจากรหัสนิสิต" readonly style="background-color: #f3f4f6;">
                        </div>
                    </div>
        </div>

                <!-- Contact Information Section -->
                <div class="form-section">
                    <h3 class="form-section-title">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                        </svg>
                        ข้อมูลติดต่อ
                    </h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="phone" class="form-label required">เบอร์โทร</label>
                            <input type="tel" id="phone" name="phone" value="<%= userData.phone %>" class="form-input" placeholder="กรุณากรอกเบอร์โทร" required>
                        </div>
                        <div class="form-group">
                            <label for="gender" class="form-label required">เพศ</label>
                            <select id="gender" name="gender" class="form-select" required>
                                <option value="">เลือกเพศ</option>
                                <option value="ชาย" <%= userData.gender === 'ชาย' ? 'selected' : '' %>>ชาย</option>
                                <option value="หญิง" <%= userData.gender === 'หญิง' ? 'selected' : '' %>>หญิง</option>
                                <option value="อื่นๆ" <%= userData.gender === 'อื่นๆ' ? 'selected' : '' %>>อื่นๆ</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="status" class="form-label required">สถานะ</label>
                            <select id="status" name="status" class="form-select" required>
                                <option value="">เลือกสถานะ</option>
                                <option value="มีห้องแล้ว" <%= userData.status === 'มีห้องแล้ว' ? 'selected' : '' %>>มีห้องแล้ว</option>
                                <option value="ยังไม่มีห้อง" <%= userData.status === 'ยังไม่มีห้อง' ? 'selected' : '' %>>ยังไม่มีห้อง</option>
                            </select>
                        </div>
                    </div>
        </div>

                <!-- Education Information Section -->
                <div class="form-section">
                    <h3 class="form-section-title">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
                        </svg>
                        ข้อมูลการศึกษา
                    </h3>
                    <div class="form-grid-2-col">
                        <div class="form-group">
                            <label for="Faculty" class="form-label required">คณะ</label>
                            <select id="Faculty" name="Faculty_id" class="form-select" required>
                                <option value="" disabled>-- กรุณาเลือกคณะ --</option>
                                <option value="1" <%= userData.Faculty_id == 1 ? 'selected' : '' %>>ศึกษาศาสตร์</option>
                                <option value="2" <%= userData.Faculty_id == 2 ? 'selected' : '' %>>วิทยาศาสตร์</option>
                                <option value="3" <%= userData.Faculty_id == 3 ? 'selected' : '' %>>วิทยาการสารสนเทศ</option>
                                <option value="4" <%= userData.Faculty_id == 4 ? 'selected' : '' %>>วิศวกรรมศาสตร์</option>
                                <option value="5" <%= userData.Faculty_id == 5 ? 'selected' : '' %>>คณะโลจิสติกส์</option>
                                <option value="6" <%= userData.Faculty_id == 6 ? 'selected' : '' %>>คณะบริหารธุรกิจและการจัดการ</option>
                                <option value="7" <%= userData.Faculty_id == 7 ? 'selected' : '' %>>คณะศิลปกรรมศาสตร์</option>
                                <option value="8" <%= userData.Faculty_id == 8 ? 'selected' : '' %>>คณะมนุษยศาสตร์และสังคมศาสตร์</option>
                                <option value="9" <%= userData.Faculty_id == 9 ? 'selected' : '' %>>คณะเภสัชศาสตร์</option>
                                <option value="10" <%= userData.Faculty_id == 10 ? 'selected' : '' %>>คณะพยาบาลศาสตร์</option>
                                <option value="11" <%= userData.Faculty_id == 11 ? 'selected' : '' %>>คณะแพทยศาสตร์</option>
                                <option value="12" <%= userData.Faculty_id == 12 ? 'selected' : '' %>>คณะสหเวชศาสตร์</option>
                                <option value="13" <%= userData.Faculty_id == 13 ? 'selected' : '' %>>คณะสาธารณสุขศาสตร์</option>
                                <option value="14" <%= userData.Faculty_id == 14 ? 'selected' : '' %>>คณะวิทยาศาสตร์การกีฬา</option>
                                <option value="15" <%= userData.Faculty_id == 15 ? 'selected' : '' %>>คณะดนตรีและการแสดง</option>
                                <option value="16" <%= userData.Faculty_id == 16 ? 'selected' : '' %>>คณะภูมิสารสนเทศศาสตร์</option>
                                <option value="17" <%= userData.Faculty_id == 17 ? 'selected' : '' %>>วิทยาลัยนานาชาติ</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="Majors" class="form-label required">สาขา</label>
                            <select id="Majors" name="Majors_id" class="form-select" required>
                                <option value="" disabled>-- กรุณาเลือกสาขา --</option>
                            </select>
                        </div>
                    </div>
                </div> 

                <!-- Additional Information Section -->
                <div class="form-section">
                    <h3 class="form-section-title">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                        </svg>
                        ข้อมูลเพิ่มเติม
                    </h3>
                    <div class="form-group">
                        <label class="form-label">ลักษณะนิสัย/ความชอบ</label>
                        <div class="personality-checkboxes">
                            <div class="checkbox-group">
                                <div class="checkbox-item">
                                    <input type="checkbox" id="personality_1" name="Personality_id" value="1" class="personality-checkbox">
                                    <label for="personality_1" class="checkbox-label">1. ชอบอ่านหนังสือ</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="personality_2" name="Personality_id" value="2" class="personality-checkbox">
                                    <label for="personality_2" class="checkbox-label">2. ชอบเล่นกีฬา</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="personality_3" name="Personality_id" value="3" class="personality-checkbox">
                                    <label for="personality_3" class="checkbox-label">3. ชอบดูหนัง</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="personality_4" name="Personality_id" value="4" class="personality-checkbox">
                                    <label for="personality_4" class="checkbox-label">4. ชอบฟังเพลง</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="personality_5" name="Personality_id" value="5" class="personality-checkbox">
                                    <label for="personality_5" class="checkbox-label">5. ชอบเล่นเกม</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="personality_6" name="Personality_id" value="6" class="personality-checkbox">
                                    <label for="personality_6" class="checkbox-label">6. ชอบออกกำลังกาย</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="personality_7" name="Personality_id" value="7" class="personality-checkbox">
                                    <label for="personality_7" class="checkbox-label">7. นอนเร็วก่อน4ทุ่ม</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="personality_8" name="Personality_id" value="8" class="personality-checkbox">
                                    <label for="personality_8" class="checkbox-label">8. นอนดึกหลังเที่ยงคืน</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="personality_9" name="Personality_id" value="9" class="personality-checkbox">
                                    <label for="personality_9" class="checkbox-label">9. ชอบความสะอาด</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="personality_10" name="Personality_id" value="10" class="personality-checkbox">
                                    <label for="personality_10" class="checkbox-label">10. ชอบพูดคุยกับเพื่อนๆ</label>
                                </div>
                            </div>
                            <div class="selection-counter">
                                เลือกได้ <span id="selected-count">0</span>/3 ตัวเลือก
                            </div>
                            <div id="checkbox-limit-warning" class="checkbox-limit-warning">
                                ⚠️ คุณเลือกได้สูงสุด 3 ตัวเลือกเท่านั้น
                            </div>
                        </div>
                    </div>
        </div>

                <!-- Form Actions -->
                <div class="button-group">
                    <button type="submit" class="save-button">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        บันทึกข้อมูล
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
      // Image preview functionality
      document.getElementById('imageInput').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = function(e) {
            const preview = document.getElementById('imagePreview');
            preview.innerHTML = `<img src="${e.target.result}" alt="Profile Image" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">`;
          };
          reader.readAsDataURL(file);
        }
      });

      // Personality checkbox management
      document.addEventListener('DOMContentLoaded', function() {
        const checkboxes = document.querySelectorAll('.personality-checkbox');
        const selectedCountSpan = document.getElementById('selected-count');
        const warningDiv = document.getElementById('checkbox-limit-warning');
        const maxSelections = 3;
        
        // Current personality data from server
        const currentPersonalities = <%- JSON.stringify(userData.personalities || []) %>;
        console.log('Current personalities:', currentPersonalities);
        
        // Pre-select current personalities
        currentPersonalities.forEach(personalityId => {
          const checkbox = document.querySelector(`input[value="${personalityId}"]`);
          if (checkbox) {
            checkbox.checked = true;
          }
        });
        
        // Update counter
        function updateCounter() {
          const selectedCount = document.querySelectorAll('.personality-checkbox:checked').length;
          selectedCountSpan.textContent = selectedCount;
          
          if (selectedCount >= maxSelections) {
            warningDiv.classList.add('show');
            // Disable unchecked checkboxes
            checkboxes.forEach(checkbox => {
              if (!checkbox.checked) {
                checkbox.disabled = true;
              }
            });
          } else {
            warningDiv.classList.remove('show');
            // Enable all checkboxes
            checkboxes.forEach(checkbox => {
              checkbox.disabled = false;
            });
          }
        }
        
        // Add event listeners
        checkboxes.forEach(checkbox => {
          checkbox.addEventListener('change', function() {
            const selectedCount = document.querySelectorAll('.personality-checkbox:checked').length;
            
            if (selectedCount > maxSelections) {
              this.checked = false;
              alert('คุณเลือกได้สูงสุด 3 ตัวเลือกเท่านั้น');
              return;
            }
            
            updateCounter();
          });
        });
        
        // Initial counter update
        updateCounter();
        
        // Form validation
        const form = document.querySelector('form');
        form.addEventListener('submit', function(e) {
          try {
            const selectedCount = document.querySelectorAll('.personality-checkbox:checked').length;
            
            if (selectedCount > maxSelections) {
              e.preventDefault();
              alert('คุณเลือกได้สูงสุด 3 ตัวเลือกเท่านั้น');
              return false;
            }
            
            // Validate year field
            const yearInput = document.getElementById('year');
            if (yearInput && (yearInput.value === 'จบการศึกษาแล้ว' || yearInput.value === 'ยังไม่เข้าศึกษา')) {
              e.preventDefault();
              alert('กรุณาตรวจสอบรหัสนิสิตให้ถูกต้อง');
              document.getElementById('student_id').focus();
              return false;
            }
          } catch (error) {
            console.error('เกิดข้อผิดพลาดในการตรวจสอบฟอร์ม:', error);
            e.preventDefault();
            alert('เกิดข้อผิดพลาดในการตรวจสอบข้อมูล กรุณาลองใหม่อีกครั้ง');
            return false;
          }
        });

        // Calculate birthdate from age on page load
        const ageValue = parseInt(document.getElementById('age').value);
        if (ageValue && ageValue > 0) {
            const today = new Date();
            const birthYear = today.getFullYear() - ageValue;
            const birthdate = new Date(birthYear, today.getMonth(), today.getDate());
            document.getElementById('birthdate').value = birthdate.toISOString().split('T')[0];
        }

        // Calculate age from birthdate
        document.getElementById('birthdate').addEventListener('change', function() {
            const birthdate = new Date(this.value);
            const today = new Date();
            let age = today.getFullYear() - birthdate.getFullYear();
            const monthDiff = today.getMonth() - birthdate.getMonth();
            
            // ถ้ายังไม่ถึงวันเกิดในปีนี้ ให้ลบอายุ 1 ปี
            if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthdate.getDate())) {
                age--;
            }
            
            document.getElementById('age').value = age;
            console.log('Birthdate:', this.value, 'Calculated age:', age);
        });

        // Calculate year from student ID
        document.getElementById('student_id').addEventListener('input', function() {
            const studentId = this.value;
            const yearInput = document.getElementById('year');
            
            try {
                if (studentId.length >= 2) {
                    const yearPrefix = studentId.substring(0, 2);
                    const currentYear = new Date().getFullYear();
                    const currentYearBE = currentYear + 543; // แปลง ค.ศ. เป็น พ.ศ.
                    const currentYearPrefix = parseInt(currentYearBE.toString().substring(2, 4)); // เอา 2 หลักหลัง
                    
                    // คำนวณปีการศึกษา
                    // ปีปัจจุบัน 2568 (68) - รหัสนิสิต 65 = 3 ปี → ปี 4
                    // ปีปัจจุบัน 2568 (68) - รหัสนิสิต 66 = 2 ปี → ปี 3
                    // ปีปัจจุบัน 2568 (68) - รหัสนิสิต 67 = 1 ปี → ปี 2
                    // ปีปัจจุบัน 2568 (68) - รหัสนิสิต 68 = 0 ปี → ปี 1
                    const yearDiff = currentYearPrefix - parseInt(yearPrefix);
                    let academicYear = yearDiff + 1;
                    
                    // รองรับทุกปีการศึกษา
                    if (academicYear > 4) {
                        yearInput.value = 'จบการศึกษาแล้ว';
                    } else if (academicYear < 1) {
                        yearInput.value = 'ยังไม่เข้าศึกษา';
                    } else {
                        yearInput.value = academicYear;
                    }
                    
                    console.log('Student ID:', studentId, 'Year Prefix:', yearPrefix, 'Current Year Prefix:', currentYearPrefix, 'Year Diff:', yearDiff, 'Academic Year:', academicYear);
                } else {
                    yearInput.value = '';
                }
            } catch (error) {
                console.error('เกิดข้อผิดพลาดในการคำนวณปีการศึกษา:', error);
                yearInput.value = '';
                alert('เกิดข้อผิดพลาดในการคำนวณปีการศึกษา กรุณาตรวจสอบรหัสนิสิต');
            }
        });

        // Faculty change - load majors
        const facultySelect = document.getElementById('Faculty');
        const majorsSelect = document.getElementById('Majors');
        const currentMajorId = <%= userData.Majors_id || 'null' %>;
        let majorsLoaded = false;
        
        async function loadMajors(facultyId, selectMajorId = null) {
          majorsSelect.innerHTML = '<option value="" disabled>-- กรุณาเลือกสาขา --</option>';
          
          if (facultyId) {
            try {
              console.log('Loading majors for faculty:', facultyId);
              const response = await fetch(`/api/majors/${facultyId}`);
              console.log('Response status:', response.status);
              
              const majors = await response.json();
              console.log('Majors received:', majors);
              
              if (majors.error) {
                console.error('API Error:', majors.error, majors.details);
                alert('ไม่สามารถโหลดข้อมูลสาขาได้: ' + (majors.details || majors.error));
                return;
              }
              
              majors.forEach(major => {
                const option = document.createElement('option');
                option.value = major.Majors_id;
                option.textContent = major.majors_name;
                if (selectMajorId && major.Majors_id == selectMajorId) {
                  option.selected = true;
                }
                majorsSelect.appendChild(option);
              });
              
              console.log('Loaded', majors.length, 'majors');
              majorsLoaded = true;
            } catch (error) {
              console.error('Error loading majors:', error);
              alert('ไม่สามารถโหลดข้อมูลสาขาได้: ' + error.message);
            }
          }
        }
        
        // Load majors on page load (only once)
        const currentFacultyId = facultySelect.value;
        if (currentFacultyId && !majorsLoaded) {
          loadMajors(currentFacultyId, currentMajorId);
        }
        
        // Load majors when faculty changes
        facultySelect.addEventListener('change', function() {
          loadMajors(this.value);
        });
      });
    </script>

</body>

</html>