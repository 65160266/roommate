<header class="main-header">
    <div class="header-container">
        <!-- Logo -->
        <a href="/home" class="header-logo">
            <div class="header-logo-icon">
                <img src="/images/LOGO.png" alt="RoomMate Logo" style="width: 40px; height: 40px; object-fit: contain;">
            </div>
            <span class="header-logo-text">RoomMate</span>
        </a>

        <!-- Navigation -->
        <nav class="header-nav">
            <a href="/home" class="nav-link">หน้าแรก</a>
            <a href="/chat" class="nav-link">แชท</a>
        </nav>

        <!-- Profile & Logout -->
        <div class="header-profile">
            <% if (typeof session !== 'undefined' && session.user) { %>
                <a href="/profile" class="profile-button">
                    <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                    <span class="profile-name"><%= session.user.email.split('@')[0] %></span>
                </a>
                <a href="/logout" class="logout-button">
                    <svg style="width: 16px; height: 16px; margin-right: 0.375rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                    </svg>
                    ออกจากระบบ
                </a>
            <% } else { %>
                <a href="/login" class="profile-button">
                    <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
                    </svg>
                    <span class="profile-name">เข้าสู่ระบบ</span>
                </a>
                <a href="/register" class="logout-button">
                    <svg style="width: 16px; height: 16px; margin-right: 0.375rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                    </svg>
                    สมัครสมาชิก
                </a>
            <% } %>
        </div>

        <!-- Mobile Menu Toggle -->
        <button class="mobile-menu-toggle" onclick="toggleMobileMenu()">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>

    <!-- Mobile Navigation -->
    <nav class="mobile-nav" id="mobileNav">
        <% if (typeof session !== 'undefined' && session.user) { %>
            <a href="/home" class="nav-link">หน้าแรก</a>
            <a href="/chat" class="nav-link">แชท</a>
            <a href="/accounts" class="nav-link">บัญชีของฉัน</a>
            <a href="/logout" class="nav-link" style="color: #991b1b;">ออกจากระบบ</a>
        <% } else { %>
            <a href="/" class="nav-link">หน้าแรก</a>
            <a href="/login" class="nav-link">เข้าสู่ระบบ</a>
            <a href="/register" class="nav-link">สมัครสมาชิก</a>
        <% } %>
    </nav>
</header>

<script>
function toggleMobileMenu() {
    const mobileNav = document.getElementById('mobileNav');
    mobileNav.classList.toggle('active');
}
</script>
