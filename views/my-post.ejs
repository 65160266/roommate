<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/post.css">
    <title>ประกาศของฉัน - RoomMate</title>
</head>
<body class="home-container">
    <%- include('partials/homeheader') %>

    <div class="post-container">
        <!-- Flash Messages -->
        <% if (typeof flash !== 'undefined' && flash) { %>
            <% if (flash.success) { %>
                <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded mb-6 shadow-md animate-fade-in" role="alert">
                    <div class="flex items-center">
                        <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <p class="font-medium"><%= flash.success %></p>
                    </div>
                </div>
            <% } %>
            <% if (flash.error) { %>
                <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 rounded mb-6 shadow-md animate-fade-in" role="alert">
                    <div class="flex items-center">
                        <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <div>
                            <p class="font-bold">แจ้งเตือน</p>
                            <p><%= flash.error %></p>
                        </div>
                    </div>
                </div>
            <% } %>
        <% } %>


        <!-- Current User's Post Section -->
        <% if (post) { %>
            <div class="post-card">
                <h2 class="text-xl font-bold mb-4" style="color: #1e40af;">ประกาศของคุณ</h2>
                <!-- User Profile Section - Horizontal Layout -->
                <div class="user-profile-horizontal">
                    <img src="<%= post.image || '/images/default-avatar.png' %>" alt="profile" class="user-avatar-horizontal">
                    <div class="user-info-horizontal">
                        <div class="user-name-row">
                            <h3 class="user-name-horizontal">
                                <%= post.first_name %> <%= post.last_name %>
                            </h3>
                            <span class="user-nickname-horizontal">(<%= post.nickname %>)</span>
                        </div>
                        <div class="user-details-row">
                            <span class="user-faculty"><%= post.faculty_name %></span>
                            <span class="user-separator">-</span>
                            <span class="user-major"><%= post.majors_name %></span>
                        </div>
                    </div>
                </div>

                <!-- Post Information Section -->
                <% if (post.content) { %>
                    <div class="post-info-section">
                        <h4 class="post-header">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                            <% if (post.room_status === 'has_room') { %>
                                มีห้องแล้ว - ต้องการคนเพิ่ม
                            <% } else { %>
                                ข้อมูลโพสต์
                            <% } %>
                        </h4>
                        
                        <!-- Room Status Badge -->
                        <div class="mb-3">
                            <% if (post.room_status === 'has_room') { %>
                                <span class="status-badge has-room">
                                    <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
                                    </svg>
                                    มีห้องแล้ว
                                </span>
                                <% if (post.people_needed && post.people_needed > 0) { %>
                                    <span class="status-badge people-needed">
                                        ต้องการ <%= post.people_needed %> คน
                                    </span>
                                <% } %>
                            <% } else { %>
                                <span class="status-badge looking">
                                    <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                    </svg>
                                    กำลังหาห้อง
                                </span>
                            <% } %>
                        </div>

                        <!-- Post Content -->
                        <div class="post-content">
                            <%= post.content %>
                        </div>

                        <!-- Room Description (if has room) -->
                        <% if (post.room_status === 'has_room' && post.room_description) { %>
                            <div class="room-description">
                                <p class="room-description-label">รายละเอียดห้อง:</p>
                                <p class="room-description-text"><%= post.room_description %></p>
                            </div>
                        <% } %>

                        <div class="post-meta">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            โพสต์เมื่อ: <%= new Date(post.created_at).toLocaleDateString('th-TH') %>
                        </div>
                    </div>
                <% } else { %>
                    <div class="no-post-section">
                        <p>ยังไม่มีเนื้อหาโพสต์</p>
                    </div>
                <% } %>

                <!-- Three-dot menu only -->
                <div class="post-actions">
                    <div class="three-dot-menu">
                        <button onclick="togglePostMenu(<%= post.Post_id %>)" class="three-dot-button">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
                            </svg>
                        </button>
                        
                        <!-- Dropdown menu -->
                        <div id="post-menu-<%= post.Post_id %>" class="dropdown-menu">
                            <a href="/post/edit/<%= post.Post_id %>" class="dropdown-item">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                </svg>
                                แก้ไขโพสต์
                            </a>
                            <button onclick="deletePost(<%= post.Post_id %>)" class="dropdown-item delete">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                                ลบโพสต์
                            </button>
                        </div>
                    </div>
                </div>
                </div>
                </div>
            </div>
        <% } else { %>
            <div class="empty-state">
                <svg class="empty-state-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <h3 class="empty-state-title">ยังไม่มีโพสต์</h3>
                <p class="empty-state-description">เริ่มต้นสร้างโพสต์แรกของคุณ</p>
                <a href="/post/create" class="create-post-button">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    สร้างโพสต์ใหม่
                </a>
            </div>
        <% } %>
        </div>
    </div>

    <script>
        // Toggle post menu
        function togglePostMenu(postId) {
            const menu = document.getElementById(`post-menu-${postId}`);
            if (menu) {
                menu.classList.toggle('show');
            }
        }

        // Delete post function
        function deletePost(postId) {
            showDeleteConfirmation(postId);
        }

        // Show delete confirmation modal
        function showDeleteConfirmation(postId) {
            // Create modal HTML
            const modalHTML = `
                <div id="delete-confirmation-modal" class="delete-confirmation-modal show">
                    <div class="delete-confirmation-content">
                        <div class="delete-confirmation-header">
                            <div class="delete-confirmation-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                                </svg>
                            </div>
                            <h3 class="delete-confirmation-title">ยืนยันการลบโพสต์</h3>
                        </div>
                        <p class="delete-confirmation-message">
                            คุณแน่ใจหรือไม่ที่จะลบโพสต์นี้? การกระทำนี้ไม่สามารถย้อนกลับได้ และข้อมูลทั้งหมดจะถูกลบอย่างถาวร
                        </p>
                        <div class="delete-confirmation-actions">
                            <button onclick="cancelDelete()" class="delete-cancel-button">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                </svg>
                                ยกเลิก
                            </button>
                            <button onclick="confirmDelete(${postId})" class="delete-confirm-button">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                                ลบโพสต์
                            </button>
                        </div>
                    </div>
                </div>
            `;
            
            // Add modal to body
            document.body.insertAdjacentHTML('beforeend', modalHTML);
            
            // Close dropdown menu
            const menu = document.getElementById(`post-menu-${postId}`);
            if (menu) {
                menu.classList.remove('show');
            }
        }

        // Cancel delete
        function cancelDelete() {
            const modal = document.getElementById('delete-confirmation-modal');
            if (modal) {
                modal.classList.remove('show');
                setTimeout(() => {
                    modal.remove();
                }, 300);
            }
        }

        // Confirm delete
        function confirmDelete(postId) {
            const modal = document.getElementById('delete-confirmation-modal');
            if (modal) {
                modal.classList.remove('show');
                setTimeout(() => {
                    modal.remove();
                }, 300);
            }

            // แสดง loading และซ่อนปุ่ม
            const postSection = document.querySelector('.post-card');
            const buttonSection = document.querySelector('.post-actions');
            
            if (postSection) {
                postSection.style.opacity = '0.5';
                postSection.style.pointerEvents = 'none';
                postSection.style.transition = 'opacity 0.3s ease';
            }
            
            if (buttonSection) {
                buttonSection.style.transition = 'opacity 0.3s ease';
                buttonSection.style.opacity = '0';
            }

            // แสดง loading indicator
            showLoadingIndicator();

            fetch(`/post/delete/${postId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                credentials: 'same-origin'
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                console.log('Delete response:', data);
                
                if (data.success) {
                    console.log('Post deleted successfully, redirecting...');
                    
                    // แสดงข้อความสำเร็จชั่วขณะ
                    showSuccessMessage(data.message || 'ลบโพสต์สำเร็จแล้ว!');
                    
                    // Redirect ทันทีไปหน้า Home
                    setTimeout(() => {
                        window.location.href = '/home';
                    }, 500);
                } else {
                    console.log('Delete failed:', data.error);
                    // กู้คืน UI
                    restoreUI(postSection, buttonSection);
                    showErrorMessage(data.error || 'เกิดข้อผิดพลาดในการลบโพสต์');
                }
            })
            .catch(error => {
                console.error('Delete post error:', error);
                // กู้คืน UI
                restoreUI(postSection, buttonSection);
                
                // ตรวจสอบประเภทของข้อผิดพลาด
                if (error.message.includes('HTTP error! status: 404')) {
                    showErrorMessage('ไม่พบโพสต์หรือคุณไม่มีสิทธิ์ลบ');
                } else if (error.message.includes('HTTP error! status: 500')) {
                    showErrorMessage('เกิดข้อผิดพลาดในเซิร์ฟเวอร์ กรุณาลองใหม่อีกครั้ง');
                } else {
                    showErrorMessage('เกิดข้อผิดพลาดในการลบโพสต์ กรุณาลองใหม่อีกครั้ง');
                }
            });
        }

        // แสดง loading indicator
        function showLoadingIndicator() {
            const postSection = document.querySelector('.post-card');
            if (postSection) {
                const loadingDiv = document.createElement('div');
                loadingDiv.id = 'loading-indicator';
                loadingDiv.className = 'absolute inset-0 bg-white bg-opacity-90 flex items-center justify-center z-50';
                loadingDiv.innerHTML = `
                    <div class="flex flex-col items-center">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mb-2"></div>
                        <p class="text-sm text-gray-600">กำลังลบโพสต์...</p>
                    </div>
                `;
                postSection.style.position = 'relative';
                postSection.appendChild(loadingDiv);
            }
        }

        // กู้คืน UI
        function restoreUI(postSection, buttonSection) {
            if (postSection) {
                postSection.style.opacity = '1';
                postSection.style.pointerEvents = 'auto';
                postSection.style.transform = 'translateX(0)';
                postSection.style.transition = 'all 0.3s ease';
                
                // ลบ loading indicator
                const loadingDiv = document.getElementById('loading-indicator');
                if (loadingDiv) {
                    loadingDiv.remove();
                }
            }
            if (buttonSection) {
                buttonSection.style.opacity = '1';
                buttonSection.style.transition = 'opacity 0.3s ease';
            }
        }

        // แสดงข้อความผิดพลาด
        function showErrorMessage(message) {
            const container = document.querySelector('.post-container');
            const errorDiv = document.createElement('div');
            errorDiv.className = 'bg-red-100 border-l-4 border-red-500 text-red-700 p-4 rounded mb-6 shadow-md';
            errorDiv.style.animation = 'fadeIn 0.3s ease-in';
            errorDiv.innerHTML = `
                <div class="flex items-center">
                    <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <div>
                        <p class="font-bold">เกิดข้อผิดพลาด</p>
                        <p>${message}</p>
                    </div>
                </div>
            `;
            container.insertBefore(errorDiv, container.firstChild);
            
            // ลบข้อความหลังจาก 5 วินาที
            setTimeout(() => {
                errorDiv.remove();
            }, 5000);
        }

        // แสดงข้อความสำเร็จ
        function showSuccessMessage(message) {
            const container = document.querySelector('.post-container');
            const successDiv = document.createElement('div');
            successDiv.className = 'bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded mb-6 shadow-md';
            successDiv.style.animation = 'fadeIn 0.3s ease-in';
            successDiv.innerHTML = `
                <div class="flex items-center">
                    <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <p class="font-medium">${message}</p>
                </div>
            `;
            container.insertBefore(successDiv, container.firstChild);
            
            // ลบข้อความหลังจาก 3 วินาที
            setTimeout(() => {
                if (successDiv.parentNode) {
                    successDiv.remove();
                }
            }, 3000);
        }

        // Close post menu when clicking outside
        document.addEventListener('click', function(event) {
            const menus = document.querySelectorAll('[id^="post-menu-"]');
            menus.forEach(menu => {
                if (!menu.contains(event.target) && !event.target.closest('[onclick*="togglePostMenu"]')) {
                    menu.classList.remove('show');
                }
            });
        });

        // Close delete confirmation modal when clicking outside
        document.addEventListener('click', function(event) {
            const modal = document.getElementById('delete-confirmation-modal');
            if (modal && event.target === modal) {
                cancelDelete();
            }
        });

        // Close modal with Escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const modal = document.getElementById('delete-confirmation-modal');
                if (modal) {
                    cancelDelete();
                }
            }
        });
    </script>
</body>
</html>
