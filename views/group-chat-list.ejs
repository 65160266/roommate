<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="css/layout.css">
    <link rel="stylesheet" href="css/styles.css">
    <link rel="stylesheet" href="css/match.css">
    <title><%= title %> - RoomMate</title>
</head>
<body class="bg-gray-100">
    <%- include('partials/homeheader') %>

    <!-- Flash Messages -->
    <% if (typeof session !== 'undefined' && session.flash) { %>
        <% if (session.flash.success) { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4 mx-4">
                <%= session.flash.success %>
            </div>
        <% } %>
        <% if (session.flash.error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 mx-4">
                <%= session.flash.error %>
            </div>
        <% } %>
    <% } %>

    <div class="container mx-auto mt-6">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-2xl font-bold text-gray-800">👥 Group Chats</h1>
            <div class="flex items-center space-x-4">
                <% if (unreadCount > 0) { %>
                    <span class="bg-red-500 text-white px-2 py-1 rounded-full text-sm">
                        <%= unreadCount %> unread
                    </span>
                <% } %>
                <a href="/group-chat/create" class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700">
                    ➕ Create Group
                </a>
                <a href="/home" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
                    ← Back to Home
                </a>
            </div>
        </div>

        <% if (userGroups && userGroups.length > 0) { %>
            <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                <div class="divide-y divide-gray-200">
                    <% userGroups.forEach(group => { %>
                        <a href="/group-chat/<%= group.group_id %>" class="block hover:bg-gray-50 transition-colors">
                            <div class="p-4 flex items-center space-x-4">
                                <!-- Group Avatar -->
                                <div class="relative">
                                    <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center text-white font-bold text-lg">
                                        <%= group.group_name.charAt(0).toUpperCase() %>
                                    </div>
                                    <% if (group.unread_count > 0) { %>
                                        <span class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center">
                                            <%= group.unread_count %>
                                        </span>
                                    <% } %>
                                </div>

                                <!-- Group Info -->
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center justify-between">
                                        <h3 class="text-lg font-semibold text-gray-900 truncate">
                                            <%= group.group_name %>
                                            <% if (group.user_role === 'admin') { %>
                                                <span class="text-xs bg-yellow-100 text-yellow-800 px-2 py-1 rounded-full ml-2">Admin</span>
                                            <% } %>
                                        </h3>
                                        <% if (group.last_message_time) { %>
                                            <span class="text-sm text-gray-500">
                                                <%= new Date(group.last_message_time).toLocaleDateString() %>
                                            </span>
                                        <% } %>
                                    </div>
                                    
                                    <div class="flex items-center justify-between mt-1">
                                        <div class="flex items-center space-x-2">
                                            <p class="text-sm text-gray-600 truncate">
                                                <% if (group.last_message) { %>
                                                    <%= group.last_message.length > 50 ? group.last_message.substring(0, 50) + '...' : group.last_message %>
                                                <% } else { %>
                                                    <span class="text-gray-400 italic">No messages yet</span>
                                                <% } %>
                                            </p>
                                            <span class="text-xs text-gray-400">
                                                <%= group.member_count %> members
                                            </span>
                                        </div>
                                        <% if (group.unread_count > 0) { %>
                                            <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Arrow Icon -->
                                <div class="text-gray-400">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                    </svg>
                                </div>
                            </div>
                        </a>
                    <% }) %>
                </div>
            </div>
        <% } else { %>
            <div class="text-center py-12">
                <div class="text-gray-500 text-lg mb-4">
                    <div class="text-6xl mb-4">👥</div>
                    <h3 class="text-xl font-semibold mb-2">No Group Chats Yet</h3>
                    <p>You haven't joined any group chats yet.</p>
                    <p class="mt-2">Create a new group or wait to be added to one!</p>
                </div>
                <div class="mt-6">
                    <a href="/group-chat/create" class="px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                        Create Your First Group
                    </a>
                </div>
            </div>
        <% } %>
    </div>

    <script>
        // Auto-hide flash messages after 5 seconds
        setTimeout(() => {
            const flashMessages = document.querySelectorAll('.bg-green-100, .bg-red-100');
            flashMessages.forEach(msg => {
                msg.style.transition = 'opacity 0.5s';
                msg.style.opacity = '0';
                setTimeout(() => msg.remove(), 500);
            });
        }, 5000);

        // Auto-refresh unread count every 30 seconds
        setInterval(() => {
            fetch('/group-chat/unread-count')
                .then(response => response.json())
                .then(data => {
                    if (data.unread_count !== undefined) {
                        const unreadElement = document.querySelector('.bg-red-500');
                        if (data.unread_count > 0) {
                            if (unreadElement) {
                                unreadElement.textContent = data.unread_count + ' unread';
                            } else {
                                // Create unread count element if it doesn't exist
                                const header = document.querySelector('.flex.items-center.justify-between');
                                const unreadSpan = document.createElement('span');
                                unreadSpan.className = 'bg-red-500 text-white px-2 py-1 rounded-full text-sm';
                                unreadSpan.textContent = data.unread_count + ' unread';
                                header.appendChild(unreadSpan);
                            }
                        } else if (unreadElement) {
                            unreadElement.remove();
                        }
                    }
                })
                .catch(error => console.log('Error fetching unread count:', error));
        }, 30000);
    </script>
</body>
</html>

