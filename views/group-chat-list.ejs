<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/group-chat-list.css">
    <title>แชทกลุ่ม - RoomMate</title>
</head>

<body class="home-container">
    <%- include('partials/homeheader') %>
    
    <div class="group-chat-container">
        <div class="group-chat-header">
            <div class="group-chat-header-info">
                <a href="/chat" class="group-chat-back">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                </a>
                <h1 class="group-chat-title">แชทกลุ่ม</h1>
            </div>
            <a href="/group-chat/create" class="create-group-btn">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                สร้างกลุ่ม
            </a>
        </div>

        <div class="group-chat-content">
            <% if (groupChats && groupChats.length > 0) { %>
                <div class="group-chat-list">
                    <% groupChats.forEach(group => { %>
                        <a href="/group-chat/<%= group.group_id %>" class="group-chat-item">
                            <div class="group-chat-avatar">
                                <svg class="group-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                </svg>
                            </div>
                            <div class="group-chat-info">
                                <div class="group-chat-name"><%= group.group_name %></div>
                                <div class="group-chat-description"><%= group.description || 'ไม่มีคำอธิบาย' %></div>
                                <div class="group-chat-meta">
                                    <span class="group-chat-members"><%= group.member_count %> สมาชิก</span>
                                    <% if (isAdmin) { %>
                                        <span class="group-chat-role bg-red-100 text-red-800 px-2 py-1 rounded-full text-xs">Admin View</span>
                                    <% } else { %>
                                        <span class="group-chat-role"><%= group.user_role === 'leader' ? 'ผู้นำ' : group.user_role === 'admin' ? 'ผู้ดูแล' : 'สมาชิก' %></span>
                                    <% } %>
                                </div>
                                <div class="group-chat-last-message">
                                    <%= group.last_message ? group.last_message.substring(0, 60) + (group.last_message.length > 60 ? '...' : '') : 'ยังไม่มีข้อความ' %>
                                </div>
                                <div class="group-chat-time">
                                    <%= group.last_message_time ? new Date(group.last_message_time).toLocaleDateString('th-TH', { 
                                        month: 'short', 
                                        day: 'numeric',
                                        hour: '2-digit',
                                        minute: '2-digit'
                                    }) : '' %>
                                </div>
                            </div>
                            <% if (group.unread_count > 0) { %>
                                <div class="group-chat-unread-badge">
                                    <%= group.unread_count %>
                                </div>
                            <% } %>
                        </a>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="group-chat-empty">
                    <div class="group-chat-empty-icon">
                        <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                    </div>
                    <h3 class="group-chat-empty-title">ยังไม่มีแชทกลุ่ม</h3>
                    <p class="group-chat-empty-text">สร้างกลุ่มใหม่หรือเข้าร่วมกลุ่มที่มีอยู่</p>
                    <a href="/group-chat/create" class="group-chat-empty-btn">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                        </svg>
                        สร้างกลุ่มแรก
                    </a>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
