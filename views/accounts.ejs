<!-- 
    หน้ากรอกข้อมูลผู้ใช้ครั้งแรก
    - กรอกข้อมูลส่วนตัว (ชื่อ, อายุ, คณะ, สาขา)
    - อัปโหลดรูปโปรไฟล์
    - เลือกบุคลิกภาพ
-->
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/accounts.css">
    <title>ข้อมูลผู้ใช้ - RoomMate</title>
</head>

<body class="home-container">
    <%- include('partials/homeheader') %>
    
    <div class="accounts-container">
        <div class="accounts-card">
            <div class="accounts-header">
                <h1 class="accounts-title">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                    ข้อมูลผู้ใช้
                </h1>
                <p class="accounts-subtitle">กรอกข้อมูลส่วนตัวของคุณเพื่อเริ่มต้นใช้งาน</p>
            </div>

            <form action="/accounts" method="POST" enctype="multipart/form-data">
                <!-- Profile Image Section -->
                <div class="profile-image-section">
                    <div class="profile-image-container">
                        <div class="profile-image-preview" id="imagePreview">
                            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                        </div>
                        <div class="profile-image-upload" onclick="document.getElementById('imageInput').click()">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                            </svg>
                        </div>
                        <input type="file" id="imageInput" name="image" class="profile-image-input" accept="image/*" required>
                    </div>
                    <p class="profile-image-label">คลิกเพื่ออัปโหลดรูปโปรไฟล์ <span style="color: #ef4444;">*</span></p>
                </div>

                <!-- Personal Information Section -->
                <div class="form-section">
                    <h3 class="form-section-title">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        ข้อมูลส่วนตัว
                    </h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="first_name" class="form-label required">ชื่อ</label>
                            <input type="text" id="first_name" name="first_name" class="form-input" placeholder="กรุณากรอกชื่อ" required>
                        </div>
                        <div class="form-group">
                            <label for="last_name" class="form-label required">นามสกุล</label>
                            <input type="text" id="last_name" name="last_name" class="form-input" placeholder="กรุณากรอกนามสกุล" required>
                        </div>
                        <div class="form-group">
                            <label for="nickname" class="form-label required">ชื่อเล่น</label>
                            <input type="text" id="nickname" name="nickname" class="form-input" placeholder="กรุณากรอกชื่อเล่น" required>
                        </div>
                        <div class="form-group">
                            <label for="student_id" class="form-label required">รหัสนักศึกษา</label>
                            <input type="text" id="student_id" name="student_id" class="form-input" placeholder="กรุณากรอกรหัสนักศึกษา (เช่น 65xxxxxxxx)" required maxlength="10">
                        </div>
                        <div class="form-group">
                            <label for="birthdate" class="form-label required">วันเดือนปีเกิด</label>
                            <input type="date" id="birthdate" name="birthdate" class="form-input" required>
                            <input type="hidden" id="age" name="age">
                        </div>
                        <div class="form-group">
                            <label for="year" class="form-label required">ปีการศึกษา</label>
                            <input type="text" id="year" name="year" class="form-input" placeholder="คำนวณจากรหัสนิสิต" readonly style="background-color: #f3f4f6;">
                        </div>
                    </div>
                </div>
                <!-- Contact Information Section -->
                <div class="form-section">
                    <h3 class="form-section-title">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                        </svg>
                        ข้อมูลติดต่อ
                    </h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="phone" class="form-label required">เบอร์โทร</label>
                            <input type="tel" id="phone" name="phone" class="form-input" placeholder="กรุณากรอกเบอร์โทร" required>
                        </div>
                        <div class="form-group">
                            <label for="gender" class="form-label required">เพศ</label>
                            <select id="gender" name="gender" class="form-select">
                                <option value="ชาย" selected>ชาย</option>
                                <option value="หญิง">หญิง</option>
                                <option value="LGBTQ">LGBTQ</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="status" class="form-label required">สถานะ</label>
                            <select id="status" name="status" class="form-select">
                                <option value="มีห้องแล้ว" selected>มีห้องแล้ว</option>
                                <option value="ยังไม่มีห้อง">ยังไม่มีห้อง</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Academic Information Section -->
                <div class="form-section">
                    <h3 class="form-section-title">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
                        </svg>
                        ข้อมูลการศึกษา
                    </h3>
                    <div class="form-grid-2-col">
                        <div class="form-group">
                            <label for="Faculty" class="form-label required">คณะ</label>
                            <select id="Faculty" name="Faculty_id" class="form-select" required>
                                <option value="" disabled selected>-- กรุณาเลือกคณะ --</option>
                                <option value="1">ศึกษาศาสตร์</option>
                                <option value="2">วิทยาศาสตร์</option>
                                <option value="3">วิทยาการสารสนเทศ</option>
                                <option value="4">วิศวกรรมศาสตร์</option>
                                <option value="5">คณะโลจิสติกส์</option>
                                <option value="6">คณะบริหารธุรกิจและการจัดการ</option>
                                <option value="7">คณะศิลปกรรมศาสตร์</option>
                                <option value="8">คณะมนุษยศาสตร์และสังคมศาสตร์</option>
                                <option value="9">คณะเภสัชศาสตร์</option>
                                <option value="10">คณะพยาบาลศาสตร์</option>
                                <option value="11">คณะแพทยศาสตร์</option>
                                <option value="12">คณะสหเวชศาสตร์</option>
                                <option value="13">คณะสาธารณสุขศาสตร์</option>
                                <option value="14">คณะวิทยาศาสตร์การกีฬา</option>
                                <option value="15">คณะดนตรีและการแสดง</option>
                                <option value="16">คณะภูมิสารสนเทศศาสตร์</option>
                                <option value="17">วิทยาลัยนานาชาติ</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="Majors" class="form-label required">สาขา</label>
                            <select id="Majors" name="Majors_id" class="form-select" required>
                                <option value="" disabled selected>-- กรุณาเลือกสาขา --</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Personal Details Section -->
                <div class="form-section">
                    <h3 class="form-section-title">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        ข้อมูลเพิ่มเติม
                    </h3>
                    <div class="form-group">
                        <label for="Personality" class="form-label">ลักษณะนิสัย/ความชอบ (เลือกได้สูงสุด 3 ตัวเลือก)</label>
                        <div class="personality-checkboxes">
                            <div class="checkbox-group">
                                <label class="checkbox-item">
                                    <input type="checkbox" name="Personality_id[]" value="1" class="personality-checkbox">
                                    <span class="checkbox-label">1. ชอบอ่านหนังสือ</span>
                                </label>
                                <label class="checkbox-item">
                                    <input type="checkbox" name="Personality_id[]" value="2" class="personality-checkbox">
                                    <span class="checkbox-label">2. ชอบเล่นกีฬา</span>
                                </label>
                                <label class="checkbox-item">
                                    <input type="checkbox" name="Personality_id[]" value="3" class="personality-checkbox">
                                    <span class="checkbox-label">3. ชอบดูหนัง</span>
                                </label>
                                <label class="checkbox-item">
                                    <input type="checkbox" name="Personality_id[]" value="4" class="personality-checkbox">
                                    <span class="checkbox-label">4. ชอบฟังเพลง</span>
                                </label>
                                <label class="checkbox-item">
                                    <input type="checkbox" name="Personality_id[]" value="5" class="personality-checkbox">
                                    <span class="checkbox-label">5. ชอบเล่นเกม</span>
                                </label>
                                <label class="checkbox-item">
                                    <input type="checkbox" name="Personality_id[]" value="6" class="personality-checkbox">
                                    <span class="checkbox-label">6. ชอบออกกำลังกาย</span>
                                </label>
                                <label class="checkbox-item">
                                    <input type="checkbox" name="Personality_id[]" value="7" class="personality-checkbox">
                                    <span class="checkbox-label">7. นอนเร็วก่อน4ทุ่ม</span>
                                </label>
                                <label class="checkbox-item">
                                    <input type="checkbox" name="Personality_id[]" value="8" class="personality-checkbox">
                                    <span class="checkbox-label">8. นอนดึกหลังเที่ยงคืน</span>
                                </label>
                                <label class="checkbox-item">
                                    <input type="checkbox" name="Personality_id[]" value="9" class="personality-checkbox">
                                    <span class="checkbox-label">9. ชอบความสะอาด</span>
                                </label>
                                <label class="checkbox-item">
                                    <input type="checkbox" name="Personality_id[]" value="10" class="personality-checkbox">
                                    <span class="checkbox-label">10. ชอบพูดคุยกับเพื่อนๆ</span>
                                </label>
                            </div>
                            <div class="selection-counter">
                                <span id="selectionCount">0</span>/3 ตัวเลือก
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="button-group">
                    <button class="save-button" type="submit">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        บันทึกข้อมูล
                    </button>
                </div> 

            </form>
        </div>
</body>

