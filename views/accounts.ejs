    };

    // Image preview functionality
    document.getElementById('imageInput').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const preview = document.getElementById('imagePreview');
                preview.innerHTML = `<img src="${e.target.result}" alt="Profile Preview" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">`;
            };
            reader.readAsDataURL(file);
        }
    });

    // Faculty and Major selection
    document.getElementById('Faculty').addEventListener('change', function () {
        const FacultyId = this.value;
        const majorSelect = document.getElementById('Majors');

        // ล้างรายการเก่า
        majorSelect.innerHTML = '<option value="" disabled selected>-- กรุณาเลือกสาขา --</option>';

        if (majorsByFaculty[FacultyId]) {
            majorsByFaculty[FacultyId].forEach(Majors => {
                const option = document.createElement('option');
                option.value = Majors.id;
                option.textContent = Majors.name;
                majorSelect.appendChild(option);
            });
        }
    });

    // Personality checkboxes limit (max 3 selections)
    const personalityCheckboxes = document.querySelectorAll('.personality-checkbox');
    const selectionCounter = document.getElementById('selectionCount');
    const maxSelections = 3;

    function updateSelectionCounter() {
        const checkedBoxes = document.querySelectorAll('.personality-checkbox:checked');
        const count = checkedBoxes.length;
        
        selectionCounter.textContent = count;
        
        // Update counter color based on selection count
        if (count >= maxSelections) {
            selectionCounter.style.color = '#ef4444';
            selectionCounter.style.fontWeight = '700';
        } else {
            selectionCounter.style.color = '#3b82f6';
            selectionCounter.style.fontWeight = '700';
        }
    }

    // Add event listeners to all personality checkboxes
    personalityCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            const checkedBoxes = document.querySelectorAll('.personality-checkbox:checked');
            
            if (checkedBoxes.length > maxSelections) {
                // If trying to select more than 3, uncheck this checkbox
                this.checked = false;
                
                // Show warning message
                showLimitWarning();
            }
            
            updateSelectionCounter();
        });
    });

    function showLimitWarning() {
        // Create warning element if it doesn't exist
        let warning = document.querySelector('.checkbox-limit-warning');
        if (!warning) {
            warning = document.createElement('div');
            warning.className = 'checkbox-limit-warning';
            warning.textContent = 'คุณสามารถเลือกได้สูงสุด 3 ตัวเลือกเท่านั้น';
            document.querySelector('.personality-checkboxes').appendChild(warning);
        }
        
        // Show warning with animation
        warning.classList.add('show');
        
        // Hide warning after 3 seconds
        setTimeout(() => {
            warning.classList.remove('show');
        }, 3000);
    }

    // Initialize counter
    updateSelectionCounter();

    // Form validation before submit
    document.querySelector('form').addEventListener('submit', function(e) {
        try {
            // Validate image upload
            const imageInput = document.getElementById('imageInput');
            if (!imageInput.files || imageInput.files.length === 0) {
                e.preventDefault();
                alert('กรุณาอัปโหลดรูปโปรไฟล์');
                imageInput.focus();
                return false;
            }
            
            const checkedBoxes = document.querySelectorAll('.personality-checkbox:checked');
            console.log('Form submitting with personality selections:', Array.from(checkedBoxes).map(cb => cb.value));
            
            // Validate personality selections
            if (checkedBoxes.length > 3) {
                e.preventDefault();
                alert('คุณสามารถเลือกได้สูงสุด 3 ตัวเลือกเท่านั้น');
                return false;
            }
            
            // Validate required fields
            const requiredFields = ['first_name', 'last_name', 'nickname', 'birthdate', 'phone', 'gender', 'student_id', 'Faculty', 'Majors', 'year', 'status'];
            for (const fieldName of requiredFields) {
                const field = document.querySelector(`[name="${fieldName}"]`);
                if (field && !field.value) {
                    e.preventDefault();
                    alert(`กรุณากรอกข้อมูล: ${field.placeholder || fieldName}`);
                    field.focus();
                    return false;
                }
            }
            
            // Validate year field
            const yearInput = document.getElementById('year');
            if (yearInput.value === 'จบการศึกษาแล้ว' || yearInput.value === 'ยังไม่เข้าศึกษา') {
                e.preventDefault();
                alert('กรุณาตรวจสอบรหัสนิสิตให้ถูกต้อง');
                document.getElementById('student_id').focus();
                return false;
            }
        } catch (error) {
            console.error('เกิดข้อผิดพลาดในการตรวจสอบฟอร์ม:', error);
            e.preventDefault();
            alert('เกิดข้อผิดพลาดในการตรวจสอบข้อมูล กรุณาลองใหม่อีกครั้ง');
            return false;
        }
    });

    // Calculate age from birthdate
    document.getElementById('birthdate').addEventListener('change', function() {
        const birthdate = new Date(this.value);
        const today = new Date();
        let age = today.getFullYear() - birthdate.getFullYear();
        const monthDiff = today.getMonth() - birthdate.getMonth();
        
        // ถ้ายังไม่ถึงวันเกิดในปีนี้ ให้ลบอายุ 1 ปี
        if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthdate.getDate())) {
            age--;
        }
        
        document.getElementById('age').value = age;
        console.log('Birthdate:', this.value, 'Calculated age:', age);
    });

    // Calculate year from student ID
    document.getElementById('student_id').addEventListener('input', function() {
        const studentId = this.value;
        const yearInput = document.getElementById('year');
        
        try {
            if (studentId.length >= 2) {
                const yearPrefix = studentId.substring(0, 2);
                const currentYear = new Date().getFullYear();
                const currentYearBE = currentYear + 543; // แปลง ค.ศ. เป็น พ.ศ.
                const currentYearPrefix = parseInt(currentYearBE.toString().substring(2, 4)); // เอา 2 หลักหลัง
                
                // คำนวณปีการศึกษา
                // ปีปัจจุบัน 2568 (68) - รหัสนิสิต 65 = 3 ปี → ปี 4
                // ปีปัจจุบัน 2568 (68) - รหัสนิสิต 66 = 2 ปี → ปี 3
                // ปีปัจจุบัน 2568 (68) - รหัสนิสิต 67 = 1 ปี → ปี 2
                // ปีปัจจุบัน 2568 (68) - รหัสนิสิต 68 = 0 ปี → ปี 1
                const yearDiff = currentYearPrefix - parseInt(yearPrefix);
                let academicYear = yearDiff + 1;
                
                // รองรับทุกปีการศึกษา
                if (academicYear > 4) {
                    yearInput.value = 'จบการศึกษาแล้ว';
                } else if (academicYear < 1) {
                    yearInput.value = 'ยังไม่เข้าศึกษา';
                } else {
                    yearInput.value = academicYear;
                }
                
                console.log('Student ID:', studentId, 'Year Prefix:', yearPrefix, 'Current Year Prefix:', currentYearPrefix, 'Year Diff:', yearDiff, 'Academic Year:', academicYear);
            } else {
                yearInput.value = '';
            }
        } catch (error) {
            console.error('เกิดข้อผิดพลาดในการคำนวณปีการศึกษา:', error);
            yearInput.value = '';
            alert('เกิดข้อผิดพลาดในการคำนวณปีการศึกษา กรุณาตรวจสอบรหัสนิสิต');
        }
    });

    // Faculty change - load majors
    document.getElementById('Faculty').addEventListener('change', async function() {
        const facultyId = this.value;
        const majorsSelect = document.getElementById('Majors');
        
        console.log('Faculty selected:', facultyId);
        
        // Clear current options
        majorsSelect.innerHTML = '<option value="" disabled selected>-- กรุณาเลือกสาขา --</option>';
        
        if (facultyId) {
            try {
                console.log('Fetching majors from:', `/api/majors/${facultyId}`);
                const response = await fetch(`/api/majors/${facultyId}`);
                console.log('Response status:', response.status);
                
                const majors = await response.json();
                console.log('Majors received:', majors);
                
                if (majors.error) {
                    console.error('API Error:', majors.error, majors.details);
                    alert('ไม่สามารถโหลดข้อมูลสาขาได้: ' + (majors.details || majors.error));
                    return;
                }
                
                majors.forEach(major => {
                    const option = document.createElement('option');
                    option.value = major.Majors_id;
                    option.textContent = major.majors_name;
                    majorsSelect.appendChild(option);
                });
                
                console.log('Loaded', majors.length, 'majors');
            } catch (error) {
                console.error('Error loading majors:', error);
                alert('ไม่สามารถโหลดข้อมูลสาขาได้: ' + error.message);
            }
        }
    });
</script>

</html>