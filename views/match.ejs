<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="css/layout.css">
    <link rel="stylesheet" href="css/styles.css">
    <link rel="stylesheet" href="css/match.css">
    <title><%= title %> - RoomMate</title>
</head>
<body class="bg-gray-100">
    <%- include('partials/homeheader') %>

    <!-- Flash Messages -->
    <% if (typeof validationErrors !== 'undefined' && validationErrors.length > 0) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            <ul>
                <% validationErrors.forEach(error => { %>
                    <li><%= error %></li>
                <% }) %>
            </ul>
        </div>
    <% } %>

    <!-- Success/Error Messages -->
    <% if (typeof session !== 'undefined' && session.flash) { %>
        <% if (session.flash.success) { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
                <%= session.flash.success %>
            </div>
        <% } %>
        <% if (session.flash.error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                <%= session.flash.error %>
            </div>
        <% } %>
    <% } %>

    <!-- Navigation Tabs -->
    <div class="container mx-auto mt-6">
        <div class="flex space-x-4 mb-6">
            <a href="/match" class="px-4 py-2 bg-blue-600 text-white rounded">Find Roommates</a>
            <a href="/match/in-progress" class="px-4 py-2 bg-gray-300 text-gray-700 rounded hover:bg-gray-400">In-Progress</a>
            <a href="/match/matched" class="px-4 py-2 bg-gray-300 text-gray-700 rounded hover:bg-gray-400">Matched</a>
        </div>

        <h2 class="text-2xl font-bold mb-6">Find Your Perfect Roommate</h2>
        
        <% if (users && users.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% users.forEach(user => { %>
                    <div class="bg-white shadow-lg rounded-lg p-6 hover:shadow-xl transition-shadow">
                        <div class="text-center">
                            <img src="<%= user.image || '/images/default-avatar.png' %>" 
                                 alt="<%= user.name %>" 
                                 class="w-24 h-24 rounded-full mx-auto mb-4 object-cover">
                            <h3 class="text-xl font-semibold text-gray-800 mb-2">
                                <%= user.name %>
                            </h3>
                            <p class="text-gray-600 mb-1">
                                <span class="font-medium">Age:</span> <%= user.age || 'Not specified' %>
                            </p>
                            <p class="text-gray-600 mb-1">
                                <span class="font-medium">Faculty:</span> <%= user.faculty_name || 'Not specified' %>
                            </p>
                            <p class="text-gray-600 mb-1">
                                <span class="font-medium">Major:</span> <%= user.majors_name || 'Not specified' %>
                            </p>
                            <% if (user.Personality) { %>
                                <p class="text-gray-600 mb-4">
                                    <span class="font-medium">Personality:</span> <%= user.Personality %>
                                </p>
                            <% } %>
                        </div>
                        
                        <div class="text-center mt-4">
                            <form action="/match" method="POST" class="inline">
                                <input type="hidden" name="target_id" value="<%= user.Accounts_id %>">
                                <button type="submit" 
                                        class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                                    Send Match Request
                                </button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-12">
                <div class="text-gray-500 text-lg">
                    <p>No available users to match with at the moment.</p>
                    <p class="mt-2">Check back later or try adjusting your preferences.</p>
                </div>
            </div>
        <% } %>
    </div>

    <script>
        // Auto-hide flash messages after 5 seconds
        setTimeout(() => {
            const flashMessages = document.querySelectorAll('.bg-green-100, .bg-red-100');
            flashMessages.forEach(msg => {
                msg.style.transition = 'opacity 0.5s';
                msg.style.opacity = '0';
                setTimeout(() => msg.remove(), 500);
            });
        }, 5000);
    </script>
</body>
</html>
