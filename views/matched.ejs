<!-- 
    หน้าจับคู่สำเร็จ
    - แสดงรายการผู้ใช้ที่จับคู่สำเร็จแล้ว
    - ดูข้อมูลเพิ่มเติมและเริ่มแชท
-->
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/home.css">
    <title>Matched Users</title>
</head>
<body class="home-container">
    <%- include('partials/homeheader') %>

    <!-- เนื้อหาหลัก -->
    <div class="container mx-auto px-4 py-6">
        <!-- Header Section -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between mb-8">
            <!-- Left Side - Navigation Tabs -->
            <div class="flex flex-col sm:flex-row gap-4 mb-6 lg:mb-0">
                <a href="/home" class="nav-tab">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                    จับคู่หารูมแมท
                </a>
                <a href="/match/in-progress" class="nav-tab">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    อยู่ระหว่างดำเนินการจับคู่ 
                </a>
                <button class="nav-tab active">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                    </svg>
                    จับคู่สำเร็จ
                </button>
            </div>
        </div>

        <!-- Content -->
        <div class="bg-white rounded-xl shadow-lg p-6">
            <h2 class="text-xl font-bold text-gray-800 mb-6">เพื่อนร่วมห้องที่จับคู่แล้ว</h2>
            
            <% if (matchedUsers && matchedUsers.length > 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <% for (var i = 0; i < matchedUsers.length; i++) { %>
                        <% var match = matchedUsers[i]; %>
                        <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl p-4 border border-green-200 shadow-sm hover:shadow-md transition-all duration-300">
                            <div class="flex items-center space-x-3 mb-3 cursor-pointer" onclick="showUserProfile(<%= match.Accounts_id %>)">
                                <img src="<%= match.image || '/images/default-avatar.png' %>" 
                                     alt="<%= match.first_name %>" 
                                     class="w-12 h-12 rounded-full object-cover border-2 border-white shadow-sm">
                                <div class="flex-1 min-w-0">
                                    <h3 class="text-sm font-semibold text-gray-900 truncate">
                                        <%= match.first_name %> <%= match.last_name %>
                                    </h3>
                                    <p class="text-xs text-gray-600 flex items-center mt-1">
                                        <svg class="w-3 h-3 mr-1 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                        </svg>
                                        อายุ <%= match.age %> ปี
                                    </p>
                                    <p class="text-xs text-gray-600 flex items-center mt-1">
                                        <svg class="w-3 h-3 mr-1 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                        </svg>
                                        <%= match.faculty_name || 'ไม่ระบุ' %>
                                    </p>
                                </div>
                            </div>
                            <div class="mt-3 flex gap-2">
                                <button onclick="showUserProfile(<%= match.Accounts_id %>)" 
                                   class="flex-1 bg-gradient-to-r from-blue-500 to-indigo-500 text-white px-3 py-2 rounded-lg text-sm font-medium hover:from-blue-600 hover:to-indigo-600 transition-all duration-300 flex items-center justify-center shadow-sm hover:shadow-md">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                    </svg>
                                    ดูข้อมูล
                                </button>
                                <a href="/chat/start/<%= match.Accounts_id %>" 
                                   class="flex-1 bg-gradient-to-r from-green-500 to-emerald-500 text-white px-3 py-2 rounded-lg text-sm font-medium hover:from-green-600 hover:to-emerald-600 transition-all duration-300 flex items-center justify-center shadow-sm hover:shadow-md">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                                    </svg>
                                    แชท
                                </a>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="text-center py-16">
                    <div class="bg-gradient-to-br from-gray-50 to-green-50 rounded-2xl p-8 border border-gray-200">
                        <svg class="w-20 h-20 text-green-400 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                        </svg>
                        <h3 class="text-xl font-semibold text-gray-700 mb-3">ยังไม่มีเพื่อนร่วมห้อง</h3>
                        <p class="text-gray-500 mb-6">เริ่มต้นการค้นหาเพื่อนร่วมห้องได้ที่หน้า Find Roommates</p>
                        <a href="/home" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-green-500 to-emerald-500 text-white rounded-lg hover:from-green-600 hover:to-emerald-600 transition-all duration-300 shadow-sm hover:shadow-md">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                            เริ่มค้นหา
                        </a>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <script>
        // Show user profile modal
        async function showUserProfile(userId) {
            try {
                const response = await fetch(`/api/user-profile/${userId}`);
                const data = await response.json();
                
                if (data.success) {
                    const user = data.user;
                    const modalHTML = `
                        <div id="userProfileModal" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 9999;">
                            <div style="background: white; border-radius: 12px; padding: 24px; max-width: 500px; width: 90%; max-height: 80vh; overflow-y: auto;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                                    <h2 style="font-size: 24px; font-weight: bold; color: #1f2937;">ข้อมูลผู้ใช้</h2>
                                    <button onclick="closeUserProfile()" style="background: #ef4444; color: white; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: none; cursor: pointer;">
                                        <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                        </svg>
                                    </button>
                                </div>
                                
                                <div style="text-align: center; margin-bottom: 20px;">
                                    <img src="${user.image || '/images/default-avatar.png'}" alt="${user.first_name}" 
                                         style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover; margin: 0 auto; border: 4px solid #10b981;">
                                </div>
                                
                                <div style="space-y: 12px;">
                                    <div style="padding: 12px; background: #f3f4f6; border-radius: 8px; margin-bottom: 12px;">
                                        <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">ชื่อ-นามสกุล</div>
                                        <div style="font-size: 18px; font-weight: 600; color: #1f2937;">${user.first_name} ${user.last_name}</div>
                                    </div>
                                    
                                    ${user.nickname ? `
                                    <div style="padding: 12px; background: #f3f4f6; border-radius: 8px; margin-bottom: 12px;">
                                        <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">ชื่อเล่น</div>
                                        <div style="font-size: 16px; font-weight: 500; color: #1f2937;">${user.nickname}</div>
                                    </div>
                                    ` : ''}
                                    
                                    ${user.age ? `
                                    <div style="padding: 12px; background: #f3f4f6; border-radius: 8px; margin-bottom: 12px;">
                                        <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">อายุ</div>
                                        <div style="font-size: 16px; font-weight: 500; color: #1f2937;">${user.age} ปี</div>
                                    </div>
                                    ` : ''}
                                    
                                    ${user.gender ? `
                                    <div style="padding: 12px; background: #f3f4f6; border-radius: 8px; margin-bottom: 12px;">
                                        <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">เพศ</div>
                                        <div style="font-size: 16px; font-weight: 500; color: #1f2937;">${user.gender === 'male' || user.gender === 'ชาย' ? 'ชาย' : user.gender === 'female' || user.gender === 'หญิง' ? 'หญิง' : user.gender === 'other' || user.gender === 'อื่นๆ' ? 'อื่นๆ' : user.gender}</div>
                                    </div>
                                    ` : ''}
                                    
                                    ${user.faculty_name ? `
                                    <div style="padding: 12px; background: #f3f4f6; border-radius: 8px; margin-bottom: 12px;">
                                        <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">คณะ</div>
                                        <div style="font-size: 16px; font-weight: 500; color: #1f2937;">${user.faculty_name}</div>
                                    </div>
                                    ` : ''}
                                    
                                    ${user.majors_name ? `
                                    <div style="padding: 12px; background: #f3f4f6; border-radius: 8px; margin-bottom: 12px;">
                                        <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">สาขา</div>
                                        <div style="font-size: 16px; font-weight: 500; color: #1f2937;">${user.majors_name}</div>
                                    </div>
                                    ` : ''}
                                    
                                    ${user.year ? `
                                    <div style="padding: 12px; background: #f3f4f6; border-radius: 8px; margin-bottom: 12px;">
                                        <div style="font-size: 14px; color: #6b7280; margin-bottom: 4px;">ชั้นปี</div>
                                        <div style="font-size: 16px; font-weight: 500; color: #1f2937;">${user.year}</div>
                                    </div>
                                    ` : ''}
                                    
                                    ${user.personalities && user.personalities.length > 0 ? `
                                    <div style="padding: 12px; background: #f3f4f6; border-radius: 8px; margin-bottom: 12px;">
                                        <div style="font-size: 14px; color: #6b7280; margin-bottom: 8px;">บุคลิกภาพ</div>
                                        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                                            ${user.personalities.map(p => `<span style="background: #10b981; color: white; padding: 4px 12px; border-radius: 16px; font-size: 14px;">${p}</span>`).join('')}
                                        </div>
                                    </div>
                                    ` : ''}
                                </div>
                            </div>
                        </div>
                    `;
                    
                    document.body.insertAdjacentHTML('beforeend', modalHTML);
                } else {
                    alert('ไม่สามารถโหลดข้อมูลผู้ใช้ได้');
                }
            } catch (error) {
                console.error('Error loading user profile:', error);
                alert('เกิดข้อผิดพลาดในการโหลดข้อมูลผู้ใช้');
            }
        }
        
        function closeUserProfile() {
            const modal = document.getElementById('userProfileModal');
            if (modal) {
                modal.remove();
            }
        }
        
        // Close modal when clicking outside
        document.addEventListener('click', function(event) {
            const modal = document.getElementById('userProfileModal');
            if (modal && event.target === modal) {
                closeUserProfile();
            }
        });
    </script>
</body>
</html>

