<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/chat-list.css">
    <title>แชท - RoomMate</title>
</head>

<body class="home-container">
    <%- include('partials/homeheader') %>
    
    <div class="chat-list-container">
        <div class="chat-list-header">
            <h1 class="chat-list-title">แชท</h1>
            <div class="chat-list-actions">
                <a href="/group-chat" class="chat-group-btn">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                    แชทกลุ่ม
                </a>
                <div class="chat-list-stats">
                    <span class="unread-count"><%= unreadCount || 0 %> ข้อความที่ยังไม่ได้อ่าน</span>
                </div>
            </div>
        </div>

        <div class="chat-list-content">
            <% if (individualChats && individualChats.length > 0) { %>
                <div class="chat-list">
                    <% individualChats.forEach(chat => { %>
                        <a href="/chat/<%= chat.chat_id %>" class="chat-item">
                            <div class="chat-avatar">
                                <img src="<%= chat.other_user_image || '/images/default-avatar.png' %>" 
                                     alt="<%= chat.other_user_name %>" 
                                     class="chat-avatar-img">
                            </div>
                            <div class="chat-info">
                                <div class="chat-name"><%= chat.other_user_name %></div>
                                <div class="chat-last-message">
                                    <%= chat.last_message ? chat.last_message.substring(0, 50) + (chat.last_message.length > 50 ? '...' : '') : 'ยังไม่มีข้อความ' %>
                                </div>
                                <div class="chat-time">
                                    <%= chat.last_message_time ? new Date(chat.last_message_time).toLocaleDateString('th-TH', { 
                                        month: 'short', 
                                        day: 'numeric',
                                        hour: '2-digit',
                                        minute: '2-digit'
                                    }) : '' %>
                                </div>
                            </div>
                            <% if (chat.unread_count > 0) { %>
                                <div class="chat-unread-badge">
                                    <%= chat.unread_count %>
                                </div>
                            <% } %>
                        </a>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="chat-empty">
                    <div class="chat-empty-icon">
                        <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                    </div>
                    <h3 class="chat-empty-title">ยังไม่มีแชท</h3>
                    <p class="chat-empty-text">เริ่มต้นการสนทนากับเพื่อนที่แมทแล้ว</p>
                    <a href="/home" class="chat-empty-btn">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        หาเพื่อนใหม่
                    </a>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
