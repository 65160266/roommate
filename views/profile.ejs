<!-- 
    หน้าโปรไฟล์ผู้ใช้
    - แสดงข้อมูลส่วนตัว
    - แสดงบุคลิกภาพ
    - ปุ่มแก้ไขโปรไฟล์
-->
<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/profile.css">
    <title>โปรไฟล์ผู้ใช้</title>
</head>

<body class="home-container">

    <%- include('partials/homeheader') %>

        <!-- เนื้อหาหลัก -->
        <main class="profile-container">
            <div class="profile-card">
                <!-- Profile Image -->
                <div class="profile-image-container">
                    <% if (userData.image) { %>
                        <img src="<%= userData.image %>" alt="Profile" class="profile-image">
                    <% } else { %>
                        <div class="profile-image-placeholder">
                            <%= userData.first_name ? userData.first_name.charAt(0) : 'U' %>
                        </div>
                    <% } %>
                </div>

                <!-- Profile Info -->
                <div class="profile-info">
                    <h2 class="profile-name">
                        <%= userData.first_name %> <%= userData.last_name %>
                    </h2>
                    
                    <p class="profile-nickname">
                        <%= userData.nickname || 'ไม่มีชื่อเล่น' %>
                    </p>

                    <!-- Profile Details -->
                    <div class="profile-details">
                        <div class="profile-detail-item">
                            <span class="profile-detail-label">รหัสนักศึกษา</span>
                            <span class="profile-detail-value"><%= userData.student_id || 'ไม่ระบุ' %></span>
                        </div>
                        
                        <div class="profile-detail-item">
                            <span class="profile-detail-label">อายุ</span>
                            <span class="profile-detail-value"><%= userData.age || 'ไม่ระบุ' %> ปี</span>
                        </div>
                        
                        <div class="profile-detail-item">
                            <span class="profile-detail-label">เพศ</span>
                            <span class="profile-detail-value"><%= userData.gender || 'ไม่ระบุ' %></span>
                        </div>
                        
                        <div class="profile-detail-item">
                            <span class="profile-detail-label">เบอร์โทร</span>
                            <span class="profile-detail-value"><%= userData.phone || 'ไม่ระบุ' %></span>
                        </div>
                        
                        <div class="profile-detail-item">
                            <span class="profile-detail-label">สถานะ</span>
                            <span class="profile-detail-value"><%= userData.status || 'ไม่ระบุ' %></span>
                        </div>
                        
                        <div class="profile-detail-item">
                            <span class="profile-detail-label">คณะ</span>
                            <span class="profile-detail-value"><%= userData.faculty_name || 'ไม่ระบุ' %></span>
                        </div>
                        
                        <div class="profile-detail-item">
                            <span class="profile-detail-label">สาขา</span>
                            <span class="profile-detail-value"><%= userData.majors_name || 'ไม่ระบุ' %></span>
                        </div>
                    </div>

                    <!-- Personality -->
                    <% if (userData.Personalitiy) { %>
                        <div class="profile-personality">
                            <strong>ลักษณะนิสัย:</strong><br>
                            <%= userData.Personalitiy %>
                        </div>
                    <% } %>

                    <!-- Action Buttons -->
                    <div class="profile-actions">
                        <a href="/edit-profile" class="btn-edit">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                            </svg>
                            แก้ไขข้อมูล
                        </a>
                        <a href="/home" class="btn-back">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                            </svg>
                            กลับหน้าหลัก
                        </a>
                    </div>
                </div>
            </div>
        </main>

</body>

</html>