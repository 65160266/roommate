<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="/socket.io/socket.io.js"></script>
    <link rel="stylesheet" href="css/layout.css">
    <link rel="stylesheet" href="css/styles.css">
    <link rel="stylesheet" href="css/match.css">
    <title><%= title %> - RoomMate</title>
    <style>
        .chat-container {
            height: calc(100vh - 200px);
            max-height: 600px;
        }
        .message-bubble {
            max-width: 70%;
            word-wrap: break-word;
        }
        .message-sent {
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            color: white;
            margin-left: auto;
        }
        .message-received {
            background: #f3f4f6;
            color: #374151;
        }
        .typing-indicator {
            display: none;
        }
        .typing-indicator.show {
            display: block;
        }
    </style>
</head>
<body class="bg-gray-100">
    <%- include('partials/homeheader') %>

    <!-- Flash Messages -->
    <% if (typeof session !== 'undefined' && session.flash) { %>
        <% if (session.flash.success) { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4 mx-4">
                <%= session.flash.success %>
            </div>
        <% } %>
        <% if (session.flash.error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 mx-4">
                <%= session.flash.error %>
            </div>
        <% } %>
    <% } %>

    <div class="container mx-auto mt-6">
        <!-- Chat Header -->
        <div class="bg-white rounded-t-lg shadow-lg p-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <a href="/chat" class="text-gray-500 hover:text-gray-700">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                </a>
                <img src="<%= chatRoomInfo.other_user_image || '/images/default-avatar.png' %>" 
                     alt="<%= chatRoomInfo.other_user_name %>" 
                     class="w-10 h-10 rounded-full object-cover">
                <div>
                    <h2 class="text-lg font-semibold text-gray-800">
                        <%= chatRoomInfo.other_user_name %>
                    </h2>
                    <p class="text-sm text-gray-500">
                        <%= chatRoomInfo.other_user_nickname %>
                    </p>
                </div>
            </div>
            <div class="flex items-center space-x-2">
                <span class="text-sm text-gray-500">Online</span>
                <div class="w-2 h-2 bg-green-500 rounded-full"></div>
            </div>
        </div>

        <!-- Chat Messages Container -->
        <div class="chat-container bg-white shadow-lg overflow-y-auto" id="chatContainer">
            <div class="p-4 space-y-4" id="messagesContainer">
                <% if (messages && messages.length > 0) { %>
                    <% messages.forEach(message => { %>
                        <div class="flex <%= message.sender_id === currentUser.Accounts_id ? 'justify-end' : 'justify-start' %>">
                            <div class="message-bubble px-4 py-2 rounded-lg <%= message.sender_id === currentUser.Accounts_id ? 'message-sent' : 'message-received' %>">
                                <p class="text-sm"><%= message.message_text %></p>
                                <p class="text-xs mt-1 opacity-70">
                                    <%= new Date(message.created_at).toLocaleTimeString() %>
                                </p>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="text-center text-gray-500 py-8">
                        <p>No messages yet. Start the conversation!</p>
                    </div>
                <% } %>
            </div>
            
            <!-- Typing Indicator -->
            <div class="typing-indicator px-4 py-2" id="typingIndicator">
                <div class="flex items-center space-x-2">
                    <div class="flex space-x-1">
                        <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce"></div>
                        <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
                        <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
                    </div>
                    <span class="text-sm text-gray-500"><%= chatRoomInfo.other_user_name %> is typing...</span>
                </div>
            </div>
        </div>

        <!-- Message Input -->
        <div class="bg-white rounded-b-lg shadow-lg p-4">
            <form id="messageForm" class="flex space-x-2">
                <input type="hidden" id="chatId" value="<%= chatRoomInfo.chat_id %>">
                <input type="text" 
                       id="messageInput" 
                       placeholder="Type your message..." 
                       class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                       maxlength="1000"
                       required>
                <button type="submit" 
                        class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                    Send
                </button>
            </form>
        </div>
    </div>

    <script>
        const chatId = document.getElementById('chatId').value;
        const messageForm = document.getElementById('messageForm');
        const messageInput = document.getElementById('messageInput');
        const messagesContainer = document.getElementById('messagesContainer');
        const chatContainer = document.getElementById('chatContainer');
        const typingIndicator = document.getElementById('typingIndicator');
        const currentUserId = <%= currentUser.Accounts_id %>;
        const otherUserName = '<%= chatRoomInfo.other_user_name %>';

        // Initialize Socket.io
        const socket = io();

        // Auto-scroll to bottom
        function scrollToBottom() {
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }

        // Add message to chat
        function addMessage(message, isOwnMessage) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `flex ${isOwnMessage ? 'justify-end' : 'justify-start'}`;
            
            const bubbleClass = isOwnMessage ? 'message-sent' : 'message-received';
            const time = new Date(message.created_at).toLocaleTimeString();
            
            messageDiv.innerHTML = `
                <div class="message-bubble px-4 py-2 rounded-lg ${bubbleClass}">
                    <p class="text-sm">${message.message_text}</p>
                    <p class="text-xs mt-1 opacity-70">${time}</p>
                </div>
            `;
            
            messagesContainer.appendChild(messageDiv);
            scrollToBottom();
        }

        // Socket.io event handlers
        socket.on('connect', () => {
            console.log('Connected to server');
            socket.emit('join-chat', chatId);
        });

        socket.on('message-received', (data) => {
            addMessage(data, data.sender_id === currentUserId);
        });

        socket.on('user-typing', (data) => {
            if (data.userId !== currentUserId) {
                typingIndicator.querySelector('span').textContent = `${data.userName} is typing...`;
                typingIndicator.classList.add('show');
            }
        });

        socket.on('user-stopped-typing', (data) => {
            if (data.userId !== currentUserId) {
                typingIndicator.classList.remove('show');
            }
        });

        // Typing indicator
        let typingTimer;
        messageInput.addEventListener('input', () => {
            socket.emit('typing', {
                chatId: chatId,
                userId: currentUserId,
                userName: '<%= currentUser.first_name %> <%= currentUser.last_name %>'
            });

            clearTimeout(typingTimer);
            typingTimer = setTimeout(() => {
                socket.emit('stop-typing', {
                    chatId: chatId,
                    userId: currentUserId
                });
            }, 1000);
        });

        // Send message
        messageForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const messageText = messageInput.value.trim();
            if (!messageText) return;

            // Disable form while sending
            messageForm.querySelector('button').disabled = true;
            messageInput.disabled = true;

            try {
                const response = await fetch(`/chat/${chatId}/message`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `message_text=${encodeURIComponent(messageText)}`
                });

                const result = await response.json();

                if (result.success) {
                    // Add message to chat immediately
                    const tempMessage = {
                        message_text: messageText,
                        created_at: result.timestamp,
                        sender_id: currentUserId
                    };
                    addMessage(tempMessage, true);
                    messageInput.value = '';

                    // Emit to other users via socket
                    socket.emit('new-message', {
                        chatId: chatId,
                        message_text: messageText,
                        created_at: result.timestamp,
                        sender_id: currentUserId
                    });
                } else {
                    alert('Error sending message: ' + result.error);
                }
            } catch (error) {
                console.error('Error sending message:', error);
                alert('Error sending message');
            } finally {
                // Re-enable form
                messageForm.querySelector('button').disabled = false;
                messageInput.disabled = false;
                messageInput.focus();
            }
        });

        // Mark messages as read when page loads
        fetch(`/chat/${chatId}/read`, { method: 'POST' })
            .catch(error => console.log('Error marking messages as read:', error));

        // Initial scroll to bottom
        scrollToBottom();

        // Auto-hide flash messages
        setTimeout(() => {
            const flashMessages = document.querySelectorAll('.bg-green-100, .bg-red-100');
            flashMessages.forEach(msg => {
                msg.style.transition = 'opacity 0.5s';
                msg.style.opacity = '0';
                setTimeout(() => msg.remove(), 500);
            });
        }, 5000);

        // Clean up on page unload
        window.addEventListener('beforeunload', () => {
            socket.emit('leave-chat', chatId);
        });
    </script>
</body>
</html>
